# Modele de secrets prod. Copier vers .env.prod.local (jamais
# committe) et renseigner avant tout demarrage :
#   cp .env.prod.local.dist .env.prod.local
#   docker compose -f compose.yml -f compose.prod.yml --env-file .env.prod.local up -d --wait

PHP_VERSION=8.4
FRANKENPHP_VERSION=1.12.7
PHP_EXTENSION_INSTALLER_VERSION=2.11.12
NODE_VERSION=24
POSTGRES_VERSION=18
MAILPIT_VERSION=1.28
MAILPIT_UI_PORT=8025
ENV=prod
TARGET=prod
USER_ID=1000
GROUP_ID=1000
PROXY_NETWORK=proxy
RUN_MIGRATIONS=0
POSTGRES_DB=edj
POSTGRES_USER=edj
POSTGRES_PASSWORD=

# Variables obligatoires (${VAR:?...}) — jamais dans le .env racine.
APP_SECRET=

# Domaine public, utilise uniquement par le routeur Traefik.
APP_DOMAIN=

# Adresse d'ecoute de Caddy DANS le conteneur. ":80" et non un domaine :
# Traefik termine le TLS en amont, rien n'ecoute sur 443 cote conteneur.
# Mettre un domaine ici ferait rediriger Traefik en boucle vers le HTTPS du
# conteneur, et ferait echouer le healthcheck qui sonderait le 443.
SERVER_NAME=:80

# Adresse du courrier sortant. null://null n'envoie rien : a remplacer par un
# vrai DSN SMTP avant toute fonctionnalite d'envoi.
MAILER_DSN=null://null

# Lien d'invitation du groupe prive des adherents (reseau social). C'est une
# invitation : elle ouvre l'acces a quiconque la detient, d'ou sa place ici et
# non dans le depot. Laisser vide s'il n'existe pas de groupe prive.
MEMBERS_GROUP_URL=

# Reseaux de confiance dont Symfony accepte les en-tetes X-Forwarded-*.
# "private_ranges" et non une adresse : Traefik est joint par le reseau
# Docker, dont l'adresse change a chaque redemarrage. Sans cela, Symfony
# genere des URL en http:// derriere un Traefik qui termine le TLS.
SYMFONY_TRUSTED_PROXIES=private_ranges
