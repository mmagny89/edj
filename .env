# Variables Docker Compose — lues uniquement par Docker Compose
# (conventions, section 3). Committe, sans secret. Genere par
# .claude/scripts/setup-symfony.sh le 2026-09-04.
#
# En staging et production, remplace (pas complete) par --env-file
# .env.staging.local / .env.prod.local, qui portent toutes les cles.

COMPOSE_FILE=compose.yml:compose.dev.yml

# Versions d'images — verifiees aupres des registres le 2026-09-04.
PHP_VERSION=8.4
FRANKENPHP_VERSION=1.12.7
PHP_EXTENSION_INSTALLER_VERSION=2.11.12
# Node : LTS active au 2026-09-04, verifie aupres du registre Docker Hub.
NODE_VERSION=24
POSTGRES_VERSION=18
EMBER_VERSION=1.6.1

# Stage du Dockerfile PHP construit par un "docker compose -f compose.yml
# build" autonome ; les overrides figent target:/image: en dur.
TARGET=dev

# UID/GID de l'hote (section 6) — machine de generation.
USER_ID=501
GROUP_ID=20

# Xdebug — jamais fige au build (section 13).
XDEBUG_MODE=off

# Ports (section 4) — valeurs fixes, jamais deduites de l'hote.
HTTP_PORT=80
HTTPS_PORT=443
HTTP3_PORT=443
POSTGRES_PORT=5432
EMBER_PORT=9191

# Mise a jour de schema au demarrage (section 8) — active en dev.
RUN_MIGRATIONS=1

# PostgreSQL — developpement uniquement.
POSTGRES_DB=edj
POSTGRES_USER=edj
POSTGRES_PASSWORD=!ChangeMe!

# Courrier sortant. En developpement, tout part vers Mailpit, qui capture
# sans jamais envoyer. Injecte dans le conteneur par compose.yml : ne jamais
# redefinir cette valeur dans app/.env (conventions, section 3).
MAILER_DSN=smtp://mailpit:1025

# Reseaux de confiance pour les en-tetes X-Forwarded-*. Vide en
# developpement : aucun proxy devant le conteneur.
TRUSTED_PROXIES=

# Mailpit — developpement uniquement (capture le courrier sortant, jamais
# d'envoi reel). L'interface web est sur http://localhost:${MAILPIT_UI_PORT}.
MAILPIT_VERSION=1.28
MAILPIT_UI_PORT=8025

# Domaine servi. En developpement, Caddy fait son propre TLS pour localhost.
# En staging et production, cette variable vaut ":80" (Traefik termine le TLS
# en amont) et le domaine reel n'apparait que dans le label Traefik.
SERVER_NAME=localhost

# Reseau Docker partage sur lequel Traefik decouvre les conteneurs, en
# staging et production. A creer une fois sur l'hote si absent :
#   docker network create proxy
# Sans effet en developpement (aucun conteneur n'y est attache).
PROXY_NETWORK=proxy
