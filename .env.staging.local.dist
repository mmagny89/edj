# Modele de secrets staging. Copier vers .env.staging.local (jamais
# committe) et renseigner avant tout demarrage :
#   cp .env.staging.local.dist .env.staging.local
#   docker compose -f compose.yml -f compose.staging.yml --env-file .env.staging.local up -d --wait

PHP_VERSION=8.5.12
FRANKENPHP_VERSION=1.13.2
PHP_EXTENSION_INSTALLER_VERSION=2.12.3
NODE_VERSION=24
POSTGRES_VERSION=18
MAILPIT_VERSION=1.28
MAILPIT_UI_PORT=8025
ENV=staging
TARGET=staging
USER_ID=1000
GROUP_ID=1000
PROXY_NETWORK=proxy
RUN_MIGRATIONS=1
POSTGRES_DB=edj
POSTGRES_USER=edj
POSTGRES_PASSWORD=

# Variables obligatoires (${VAR:?...}) — jamais dans le .env racine.
APP_SECRET=

# Domaine public, utilise uniquement par le routeur Traefik.
APP_DOMAIN=

# Adresse d'ecoute de Caddy DANS le conteneur. ":80" et non un domaine :
# Traefik termine le TLS en amont, rien n'ecoute sur 443 cote conteneur.
# Mettre un domaine ici ferait rediriger Traefik en boucle vers le HTTPS du
# conteneur, et ferait echouer le healthcheck qui sonderait le 443.
SERVER_NAME=:80

# Adresse du courrier sortant. null://null n'envoie rien : a remplacer par un
# vrai DSN SMTP avant toute fonctionnalite d'envoi.
MAILER_DSN=null://null

# Adresse d'expedition des courriels : obligatoire. Elle doit appartenir a un
# domaine que l'association controle ET qui est authentifie (SPF, DKIM) chez le
# fournisseur d'envoi : Brevo remplace l'expediteur d'un domaine non
# authentifie, et une adresse gmail.com ne peut pas l'etre. Ex. :
# contact@enviedejouer89.fr, ou noreply@mmagny.fr en attendant.
MAILER_FROM=

# Lien d'invitation du groupe WhatsApp des adherents. C'est une
# invitation : elle ouvre l'acces a quiconque la detient, d'ou sa place ici et
# non dans le depot. Laisser vide s'il n'y a pas de groupe WhatsApp.
MEMBERS_WHATSAPP_URL=

# Indexation par les moteurs de recherche. 0 tant que le domaine definitif n'est
# pas en service : robots.txt interdit tout et chaque page est en noindex. Passer
# a 1 le jour de la mise en ligne sous le vrai domaine, puis redeployer. Facultative
# (repli a 0) : un oubli laisse le site invisible, jamais indexe par erreur.
SITE_INDEXABLE=0

# Reseaux de confiance dont Symfony accepte les en-tetes X-Forwarded-*.
# "private_ranges" et non une adresse : Traefik est joint par le reseau
# Docker, dont l'adresse change a chaque redemarrage. Sans cela, Symfony
# genere des URL en http:// derriere un Traefik qui termine le TLS.
SYMFONY_TRUSTED_PROXIES=private_ranges
