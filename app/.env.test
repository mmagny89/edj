# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Les tests ne passent pas par Docker Compose : les variables que compose.yml
# injecte n'existent nulle part ici, et la compilation du conteneur echoue sur
