{% extends 'app/shell.html.twig' %}

{% import 'app/_icons.html.twig' as ui %}
{% form_theme form 'app/form_theme.html.twig' %}

{% block title %}Mot de passe oublié - Envie de Jouer{% endblock %}

{% block body %}
    <main class="flex min-h-screen items-center justify-center px-4 py-10">
        <div class="w-full max-w-sm">
            <div class="mb-6 text-center">
                <img src="/img/edj-mascotte-transparent.png" alt="" class="mx-auto size-20" width="80" height="80">
                <h1 class="mt-3 text-2xl font-bold text-ink">Mot de passe oublié</h1>
                <p class="text-sm text-slate-600">Administration · Envie de Jouer</p>
            </div>

            <div class="card p-6">
                {% for message in app.flashes('error') %}
                    <div class="mb-5 rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm font-semibold text-red-900" role="alert">{{ message }}</div>
                {% endfor %}

                <p class="mb-5 text-sm text-slate-700">
                    Saisissez l'adresse e-mail de votre compte. Si elle correspond à un compte,
                    vous recevrez un lien pour choisir un nouveau mot de passe.
                </p>

                {{ form_start(form, {attr: {class: 'space-y-5', novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    {{ form_row(form.email) }}
                    <button type="submit" class="btn btn-primary w-full">{{ ui.icon('check') }} Recevoir le lien</button>
                {{ form_end(form) }}
            </div>

            <p class="mt-6 text-center text-sm">
                <a href="{{ path('app_login') }}" class="inline-flex min-h-11 items-center gap-1.5 py-2 font-semibold text-brand underline underline-offset-4 hover:text-brand-dark">{{ ui.icon('arrow-left', 'size-4') }} Retour à la connexion</a>
            </p>
        </div>
    </main>
{% endblock %}
