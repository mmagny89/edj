{% extends 'app/shell.html.twig' %}

{% block title %}Connexion - Envie de Jouer{% endblock %}

{# La page de connexion n'herite plus de la mise en page de l'administration :
   elle affichait le menu — et ses liens — a un visiteur anonyme. #}
{% block body %}
    <main class="flex min-h-screen items-center justify-center px-4 py-10">
        <div class="w-full max-w-sm">
            <div class="mb-6 text-center">
                <img src="/img/edj-mascotte-transparent.png" alt="" class="mx-auto size-20" width="80" height="80">
                <h1 class="mt-3 text-2xl font-bold text-ink">Administration</h1>
                <p class="text-sm text-slate-500">Envie de Jouer</p>
            </div>

            <div class="card p-6">
                {% if error %}
                    <div class="mb-5 rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm font-semibold text-red-900" role="alert">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <form method="post" class="space-y-5">
                    <div>
                        <label for="inputEmail" class="mb-1.5 block text-sm font-semibold text-slate-800">Adresse e-mail</label>
                        <input type="email" name="_username" id="inputEmail" value="{{ last_username }}"
                               class="block min-h-11 w-full rounded-lg border border-slate-300 px-3 py-2 text-base focus:border-brand"
                               autocomplete="username" required autofocus>
                    </div>

                    <div>
                        <label for="inputPassword" class="mb-1.5 block text-sm font-semibold text-slate-800">Mot de passe</label>
                        <input type="password" name="_password" id="inputPassword"
                               class="block min-h-11 w-full rounded-lg border border-slate-300 px-3 py-2 text-base focus:border-brand"
                               autocomplete="current-password" required>
                    </div>

                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                    <button type="submit" class="btn btn-primary w-full">Se connecter</button>
                </form>
            </div>

            <p class="mt-6 text-center text-sm">
                <a href="{{ path('site_index') }}" class="font-semibold text-brand underline underline-offset-4 hover:text-brand-dark">← Retour au site</a>
            </p>
        </div>
    </main>
{% endblock %}
