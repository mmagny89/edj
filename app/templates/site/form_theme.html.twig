{#- Theme du bulletin d'adhesion public.
    form_div_layout rend une case a cocher APRES son libelle, sur deux lignes :
    le libelle en gras, puis une petite case orpheline en dessous. Ici la case
    precede son libelle sur une meme ligne — c'est ce qu'on attend d'une case a
    cocher —, et chaque bouton radio de la formule d'adhesion est traite de
    meme. -#}
{% use 'form_div_layout.html.twig' %}

{%- block checkbox_row -%}
    <div class="choice-row">
        {{- form_widget(form) -}}
        <div class="choice-row__text">
            {{- form_label(form) -}}
            {{- form_help(form) -}}
            {{- form_errors(form) -}}
        </div>
    </div>
{%- endblock checkbox_row -%}

{%- block choice_widget_expanded -%}
    <div {{ block('widget_container_attributes') }}>
        {%- for child in form -%}
            <div class="choice-row">
                {{- form_widget(child) -}}
                <div class="choice-row__text">{{- form_label(child, null, {translation_domain: choice_translation_domain}) -}}</div>
            </div>
        {%- endfor -%}
    </div>
{%- endblock choice_widget_expanded -%}
