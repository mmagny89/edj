{% extends 'site/layout.html.twig' %}

{% form_theme form 'site/form_theme.html.twig' %}

{% block description %}Remplissez en ligne le bulletin d'adhésion à Envie de Jouer, association de jeux de société à Joigny : 10 € par an, personne supplémentaire du même foyer 5 €.{% endblock %}
{% block title %}Bulletin d'adhésion - Envie de Jouer{% endblock %}

{% block main %}
    <main id="contenu" class="section membership-form-page">
        {# Avec « renewal », on arrive par le lien signe d'un adherent : le
           formulaire est pre-rempli, et le choix de formule n'a pas a etre propose. #}
        {% if renewal is not defined %}
            {% include 'site/_membership_choice.html.twig' with {active: 'new'} only %}
        {% endif %}

        <div class="section__intro">
            <p class="eyebrow">Adhésion</p>
            {% if renewal is defined %}
                <h1>Renouveler mon adhésion</h1>
                <p>
                    Numéro d'adhérent : <strong class="member-number">{{ renewal.number }}</strong>.
                    Vos informations de l'an dernier sont déjà là : relisez-les, corrigez ce qui a
                    changé, puis signez de nouveau. Votre renouvellement ne compte qu'une fois la
                    cotisation réglée à l'association, pour la saison {{ season }}.
                </p>
            {% else %}
                <h1>Bulletin d'adhésion</h1>
                <p>
                    Le même bulletin que sur papier, à remplir en ligne. Une adhésion correspond à un
                    bulletin : pour une famille, chaque membre remplit le sien en désignant le même
                    adhérent principal.
                </p>
            {% endif %}
        </div>

        {# Mention des champs obligatoires, avant le premier champ. #}
        <p class="form-required-note"><span aria-hidden="true">*</span> Champ obligatoire</p>
        {{ form_start(form, {'attr': {'class': 'membership-form', 'novalidate': 'novalidate', 'data-controller': 'membership-type', 'data-action': 'change->membership-type#refresh input->membership-type#refresh'}}) }}
            {% if not form.vars.valid %}
                <p class="form-alert" role="alert">
                    <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
                    Le bulletin n'a pas pu être envoyé : quelques champs demandent votre attention.
                </p>

                {# Erreurs non rattachees a un champ — jeton CSRF invalide,
                   contraintes de classe. Sans ce rendu, un envoi refuse par
                   le jeton echoue en silence : le visiteur voit un formulaire
                   vide sans savoir pourquoi. #}
                {{ form_errors(form) }}
            {% endif %}

            <fieldset>
                <legend>Vos coordonnées</legend>
                <div class="form-grid">
                    {{ form_row(form.lastName) }}
                    {{ form_row(form.firstName) }}
                    {{ form_row(form.birthDate) }}
                    {{ form_row(form.phone) }}
                    <div class="form-grid__wide">{{ form_row(form.address) }}</div>
                    {{ form_row(form.postalCode) }}
                    {{ form_row(form.city) }}
                    <div class="form-grid__wide">{{ form_row(form.email) }}</div>
                </div>
            </fieldset>

            <fieldset>
                <legend>Adhésion et cotisation</legend>
                <p class="form-note">Choisissez la formule qui correspond à <strong>votre situation</strong> :</p>
                {{ form_row(form.membershipType) }}

                {# Visible sans JavaScript ; avec, il n'apparait que pour la formule
                   famille, qui est la seule a en avoir besoin. #}
                <div class="family-panel" data-membership-type-target="family">
                    {{ form_row(form.principalMemberName) }}
                </div>
                <p class="form-note">
                    Pour les enfants de <strong>moins de 14 ans</strong>, l'adhésion doit être rattachée
                    à un adulte. Pour les enfants de <strong>moins de 8 ans</strong>, elle est gratuite.
                </p>
            </fieldset>

            {# Visible sans JavaScript ; avec, il n'apparait que pour un adherent de
               moins de 18 ans (voir membership-type_controller.js). #}
            <fieldset data-membership-type-target="guardian">
                <legend>Responsable légal</legend>
                <p class="form-note">
                    <strong>Obligatoire si l'adhérent a moins de 18 ans</strong> : c'est le responsable légal qui signe.
                </p>
                <div class="form-grid">
                    {{ form_row(form.guardianLastName) }}
                    {{ form_row(form.guardianFirstName) }}
                    <div class="form-grid__wide">{{ form_row(form.guardianEmail) }}</div>
                </div>
            </fieldset>

            <fieldset>
                <legend>Avantage ludique</legend>
                {{ form_row(form.philibertConsent) }}
                {# Visible seulement quand la formule consommateur est choisie
                   (voir membership-type_controller.js). #}
                <p class="form-note" data-membership-type-target="philibertNote" role="status" hidden>
                    Cet avantage est réservé aux adhérents à l'année : la formule consommateur n'y donne pas droit.
                </p>
                <p class="form-note">
                    Autres avantages inclus dans l'adhésion : 5 % de remise à La Crique au Jeu (Sens)
                    sur présentation de la carte d'adhérent, 10 % de réduction chez Carte sur Table
                    (Auxerre), carte à demander auprès du Conseil d'Administration.
                </p>
            </fieldset>

            <fieldset>
                <legend>Droit à l'image</legend>
                {{ form_row(form.imageRightsRefused) }}
            </fieldset>

            <fieldset>
                <legend>Déclaration d'adhésion</legend>
                {{ form_row(form.statutesAccepted) }}
                {{ form_row(form.rulesAccepted) }}

                <p class="form-note">
                    Les informations recueillies sont nécessaires à la gestion des activités ludiques et
                    à la communication interne d'Envie de Jouer. Elles font l'objet d'un traitement
                    informatique et sont destinées au Conseil d'Administration de l'association. En
                    application de la loi n°78-17 du 6 janvier 1978 relative à l'informatique, aux
                    fichiers et aux libertés (conformité RGPD), vous bénéficiez d'un droit d'accès, de
                    rectification et de suppression des informations qui vous concernent. Pour exercer
                    ce droit : <a href="mailto:enviedejouer89300@gmail.com">enviedejouer89300@gmail.com</a>.
                </p>

                <div class="form-grid">
                    {{ form_row(form.signaturePlace) }}
                    {{ form_row(form.signatureName) }}
                </div>
            </fieldset>

            {{ form_row(form.website) }}

            <div class="form-actions">
                <button type="submit" class="button button--primary">
                    <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
                    Envoyer mon bulletin
                </button>
                <a href="{{ path('site_index') }}#adhesion" class="button button--quiet">Retour à l'adhésion</a>
            </div>

            {# Information obligatoire au moment de la collecte (RGPD, art. 13) :
               elle doit figurer sur le formulaire lui-meme, pas seulement dans
               le pied de page. #}
            <p class="form-privacy">
                Les informations recueillies servent à instruire votre adhésion et à la gestion
                de l'association. Vous disposez d'un droit d'accès, de rectification et
                d'effacement : voir la page
                <a href="{{ path('site_privacy') }}">Données personnelles</a>.
            </p>
        {{ form_end(form) }}
    </main>
{% endblock %}
