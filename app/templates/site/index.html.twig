{% extends 'site/layout.html.twig' %}

{% block main %}
    <main id="accueil">
        <section class="hero">
            <div class="hero__content">
                <p class="eyebrow">Association de jeux de société modernes à Joigny</p>
                <h1 class="hero-title">
                    <span>Envie de</span>
                    <span class="hero-title__play">
                        <img src="/img/edj-mascotte-transparent.png" alt="" aria-hidden="true">
                        Jouer
                    </span>
                </h1>
                <p class="hero__lead">
                    Des tables toute l'année, une ludothèque généreuse et des rendez-vous réguliers,
                    pour celles et ceux qui aiment découvrir, expliquer, rire, perdre dignement et recommencer.
                </p>

                <div class="hero__actions" aria-label="Actions principales">
                    <a href="#calendrier" class="button button--primary">
                        <i class="fa-solid fa-calendar-days" aria-hidden="true"></i>
                        Voir les prochaines dates
                    </a>
                    <a href="{{ path('membership_form') }}" class="button button--join">
                        <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                        Adhérer en ligne
                    </a>
                    <a href="mailto:enviedejouer89300@gmail.com" class="button button--quiet">
                        <i class="fa-solid fa-envelope" aria-hidden="true"></i>
                        Nous contacter
                    </a>
                </div>

                <div class="hero-pills" aria-label="Informations rapides">
                    <span><i class="fa-solid fa-location-dot" aria-hidden="true"></i> Maison des Associations, Joigny</span>
                    <span><i class="fa-solid fa-dice" aria-hidden="true"></i> Tous les mardis soir</span>
                    <span><i class="fa-solid fa-calendar-day" aria-hidden="true"></i> 1er samedi du mois</span>
                </div>
            </div>

            <aside class="next-event" aria-labelledby="next-event-title">
                <span class="next-event__label">Prochain rendez-vous</span>
                <h2 id="next-event-title" data-next-event-title>Soirée jeux du mardi</h2>
                <p class="next-event__date" data-next-event-date>Tous les mardis</p>
                <p data-next-event-meta>De 18h30 à minuit. L'adhésion se prend sur place.</p>
                <a href="#calendrier">Voir les prochaines dates</a>
            </aside>

        </section>

        <section id="calendrier" class="section section--calendar">
            <div class="section__intro">
                <p class="eyebrow">Calendrier</p>
                <h2>Les prochaines dates</h2>
                <p>
                    Repère ton créneau, prépare la prochaine table et viens jouer : les soirées du mardi
                    et les après-midi du 1er samedi rassemblent les adhérents autour de la ludothèque,
                    tout au long de la saison.
                </p>
            </div>

            {# Les evenements saisis dans le back-office voyagent en JSON sur cet
               attribut : le carrousel les fusionne avec les mardis et les 3e
               samedis qu'il calcule lui-meme. Twig echappe la valeur, aucune
               saisie ne peut donc s'echapper de l'attribut. #}
            <div class="event-carousel" data-event-carousel
                 data-events="{{ events|json_encode }}">
                <div class="calendar-toolbar" aria-label="Filtrer les événements">
                    <button class="calendar-filter is-active" type="button" data-filter="all">Tous</button>
                    <button class="calendar-filter" type="button" data-filter="weekly">Mardis</button>
                    <button class="calendar-filter" type="button" data-filter="monthly">1ers samedis</button>
                    <button class="calendar-filter" type="button" data-filter="special">Manifestations</button>
                </div>

                <div class="carousel-controls" aria-label="Navigation du carrousel">
                    <button type="button" data-carousel-prev aria-label="Événements précédents">
                        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                    </button>
                    <button type="button" data-carousel-next aria-label="Événements suivants">
                        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="event-track" data-event-track aria-live="polite"></div>
            </div>
        </section>

        <section id="rendez-vous" class="section">
            <div class="section__intro">
                <p class="eyebrow">La saison</p>
                <h2>Nos rendez-vous</h2>
                <p>
                    Deux rendez-vous réguliers qui rythment l'année, des temps forts qui la ponctuent,
                    et deux sorties où l'on retrouve d'autres joueurs.
                </p>
            </div>

            <div class="rendezvous-grid">
                <div>
                    <h3 class="rendezvous-grid__title">Toute l'année</h3>
                    <div class="info-board">
                        <article>
                            <i class="fa-solid fa-dice" aria-hidden="true"></i>
                            <h3>Les mardis soir</h3>
                            <p>Chaque semaine, de 18h30 à minuit, à la Maison des Associations.</p>
                        </article>
                        <article>
                            <i class="fa-solid fa-calendar-day" aria-hidden="true"></i>
                            <h3>Les 1ers samedis du mois</h3>
                            <p>Une après-midi ludique par mois, de 14h à 18h.</p>
                        </article>
                    </div>
                </div>

                <div>
                    <h3 class="rendezvous-grid__title">Les temps forts</h3>
                    <div class="info-board">
                        <article>
                            <i class="fa-solid fa-moon" aria-hidden="true"></i>
                            <h3>Quatre Nuits du Jeu</h3>
                            <p>Quatre nuits dans la saison, pour les longues parties et les grosses tables.</p>
                        </article>
                        <article>
                            <i class="fa-solid fa-cake-candles" aria-hidden="true"></i>
                            <h3>La Nuit anniversaire</h3>
                            <p>Une quatrième nuit, celle qui fête l'anniversaire de l'association.</p>
                        </article>
                        <article>
                            <i class="fa-solid fa-calendar-week" aria-hidden="true"></i>
                            <h3>Le week-end du Jeu</h3>
                            <p>Deux jours de jeu pour la Fête des Jeux.</p>
                        </article>
                    </div>
                </div>

                <div>
                    <h3 class="rendezvous-grid__title">On sort de nos murs</h3>
                    <div class="info-board">
                        <article>
                            <i class="fa-solid fa-star" aria-hidden="true"></i>
                            <h3>Festival Le Sens du Jeu</h3>
                            <p>À Sens, aux côtés de Sens Ludique.</p>
                        </article>
                        <article>
                            <i class="fa-solid fa-people-roof" aria-hidden="true"></i>
                            <h3>Fête des associations</h3>
                            <p>À Joigny, pour rencontrer celles et ceux qui ne nous connaissent pas encore.</p>
                        </article>
                    </div>
                </div>
            </div>

            <div class="join-banner">
                <p>Tous ces rendez-vous sont ouverts par l'adhésion.</p>
                <a href="{{ path('membership_form') }}" class="button button--join">
                    <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                    Remplir le bulletin en ligne
                </a>
            </div>
        </section>

        <section id="association" class="section association-section">
            <div class="section__intro">
                <p class="eyebrow">L'association</p>
                <h2>Une ludothèque vivante à Joigny</h2>
                <p>
                    Créée en 2023, Envie de Jouer rassemble des passionnés de jeux de société
                    autour de soirées régulières, d'après-midi ludiques et de manifestations.
                </p>
            </div>

            <div class="stats-grid" aria-label="Chiffres clés">
                <article>
                    <strong class="counter" data-count="2023">0</strong>
                    <span>création</span>
                </article>
                <article>
                    <strong class="counter" data-count="70">0</strong>
                    <span>adhérents 2025</span>
                </article>
                <article>
                    <strong class="counter" data-count="1300">0</strong>
                    <span>jeux dans les ludothèques de nos membres</span>
                </article>
                <article>
                    <strong class="counter" data-count="110">0</strong>
                    <span>soirées adhérents</span>
                </article>
                <article>
                    <strong class="counter" data-count="125">0</strong>
                    <span>événements déjà organisés</span>
                </article>
            </div>
        </section>

        <section id="adhesion" class="section membership">
            <div class="section__intro">
                <p class="eyebrow">Adhésion</p>
                <h2>Rejoindre l'association</h2>
                <p>
                    Une cotisation par saison, du 1<sup>er</sup> octobre au 30 septembre suivant,
                    qui ouvre tous nos rendez-vous et l'accès à la vie associative.
                </p>
            </div>

            {# La section se lit de haut en bas : ce que ca coute, ce que ca
               ouvre, puis comment adherer. Les trois panneaux cote a cote
               d'avant se lisaient en parallele, et le bouton d'adhesion
               flottait au-dessus sans rien conclure. #}
            <div class="membership__flow">
                <section class="membership-band membership-band--prices">
                    <h3>Ce que ça coûte</h3>

                    {# Deux groupes, deux echeances : la cotisation annuelle
                       (10 € puis 5 € par personne en plus) tient dans un seul
                       cadre, et le tarif a l'evenement se lit a part, sous son
                       propre intitule — on ne les additionne pas. #}
                    <div class="price-group price-group--year">
                        <p class="price-group__label"><i class="fa-solid fa-calendar-check" aria-hidden="true"></i> À l'année</p>
                        <p class="price-group__note">Valable toute la saison, quel que soit le nombre de venues.</p>

                        <div class="price-group__lines">
                            <p class="price-line price-line--lead">
                                <span class="price-line__amount">10 €</span>
                                <span class="price-line__for">par personne</span>
                            </p>
                            <p class="price-line">
                                <span class="price-line__amount">+ 5 €</span>
                                <span class="price-line__for">par personne supplémentaire du même foyer</span>
                            </p>
                        </div>
                    </div>

                    <div class="price-group price-group--event">
                        <p class="price-group__label"><i class="fa-solid fa-ticket" aria-hidden="true"></i> À l'événement</p>
                        <p class="price-group__note">Adhésion gratuite : on paie seulement ce à quoi on vient.</p>

                        <p class="price-line">
                            <span class="price-line__amount">1 €</span>
                            <span class="price-line__for">par événement</span>
                        </p>
                    </div>

                    <p class="membership-band__note">Le règlement se fait sur place, lors d'une de nos soirées.</p>
                </section>

                <section class="membership-band membership-band--join">
                    <div class="membership-band__head">
                        <h3>Adhérer</h3>
                        <a href="{{ path('membership_form') }}" class="button button--join">
                            <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                            Remplir le bulletin en ligne
                        </a>
                    </div>

                    <p class="membership-band__label">L'adhésion ouvre :</p>
                    <ul class="membership-perks">
                        <li>Les soirées du mardi, de 18h30 à minuit.</li>
                        <li>Les après-midi ludiques du 1er samedi du mois.</li>
                        <li>Les quatre Nuits du Jeu, dont celle de l'anniversaire.</li>
                        <li>Le week-end du Jeu pour la Fête des Jeux.</li>
                        <li>Nos sorties : le festival Le Sens du Jeu et la fête des associations.</li>
                        <li>La ludothèque, les explications autour des tables et la vie de l'association.</li>
                    </ul>


                    <p class="membership-band__note">À lire avant d'adhérer :</p>

                    <ul class="document-links">
                        <li>
                            <a href="/statuts.pdf" download>
                                <i class="fa-solid fa-file-lines" aria-hidden="true"></i>
                                <span class="document-links__label">Statuts</span>
                                <span class="document-links__meta">PDF</span>
                                <i class="fa-solid fa-download document-links__action" aria-hidden="true"></i>
                            </a>
                        </li>
                        <li>
                            <a href="/reglement_interieur.pdf" download>
                                <i class="fa-solid fa-scroll" aria-hidden="true"></i>
                                <span class="document-links__label">Règlement intérieur</span>
                                <span class="document-links__meta">PDF</span>
                                <i class="fa-solid fa-download document-links__action" aria-hidden="true"></i>
                            </a>
                        </li>
                        <li>
                            <a href="/annexes.pdf" download>
                                <i class="fa-solid fa-paperclip" aria-hidden="true"></i>
                                <span class="document-links__label">Annexes</span>
                                <span class="document-links__meta">PDF</span>
                                <i class="fa-solid fa-download document-links__action" aria-hidden="true"></i>
                            </a>
                        </li>
                    </ul>
                </section>
            </div>
        </section>

        <section class="section mascot-section">
            <div>
                <p class="eyebrow">Mascotte</p>
                <h2>Perceval, le chevalier des jeux</h2>
                <p>
                    Son nom s'inspire de la série Kaamelott, d'Alexandre Astier, et en particulier du
                    personnage Perceval, connu pour expliquer des jeux de manière parfois farfelue.
                </p>
                <p>
                    Le choix d'un chevalier évoque le riche passé historique de Joigny, marqué par son
                    héritage médiéval et par des périodes influencées par des présences militaires d'autrefois.
                </p>
                <p>
                    Perceval, aux couleurs de Joigny, vert, bleu et blanc, porte fièrement son casque,
                    un dé de 6 et un bouclier orné du maillet emblématique de la ville.
                </p>
            </div>
            <img src="/img/edj-mascotte-transparent.png" alt="Perceval, mascotte chevalier d'Envie de Jouer">
        </section>

        <section id="contact" class="section contact-section">
            <div class="contact-layout">
                <div>
                    <div class="section__intro">
                        <p class="eyebrow">Contact</p>
                        <h2>Une question, une envie de passer ?</h2>
                        <p>Le plus simple : nous écrire ou suivre les annonces des prochaines manifestations.</p>
                    </div>

                    <div class="contact-actions">
                        <a href="mailto:enviedejouer89300@gmail.com" class="button button--primary">
                            <i class="fa-solid fa-envelope" aria-hidden="true"></i>
                            enviedejouer89300@gmail.com
                        </a>
                        <a href="{{ path('membership_form') }}" class="button button--join">
                            <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                            Adhérer en ligne
                        </a>
                        <a href="{{ social_facebook }}" target="_blank" rel="noreferrer" class="button button--social">
                            <i class="fa-brands fa-facebook-f" aria-hidden="true"></i>
                            Facebook
                        </a>
                        <a href="{{ social_instagram }}" target="_blank" rel="noreferrer" class="button button--social">
                            <i class="fa-brands fa-instagram" aria-hidden="true"></i>
                            Instagram
                        </a>
                    </div>
                </div>

                <aside id="partenaires" class="partners-panel">
                    <p class="eyebrow">Partenaires</p>
                    <h2>Ils jouent avec nous</h2>
                    {# Les logos des partenaires sont servis depuis
                       public/img/partenaires : aucune ressource externe, le
                       site devant rester affichable sans acces a un CDN. #}
                    <div class="partners-list" aria-label="Liste des partenaires">
                        <article>
                            <img src="/img/partenaires/ville-de-joigny.png" alt="" width="54" height="54" loading="lazy">
                            <span><a href="https://www.ville-joigny.fr/" target="_blank" rel="noreferrer">Ville de Joigny</a></span>
                        </article>
                        <article>
                            <img src="/img/partenaires/sens-ludique.jpg" alt="" width="54" height="54" loading="lazy">
                            <span><a href="https://www.sensludique.com/" target="_blank" rel="noreferrer">Sens Ludique</a></span>
                        </article>
                        <article>
                            <img src="/img/partenaires/ludipassion.png" alt="" width="54" height="54" loading="lazy">
                            <span><a href="https://ludipassion.fr/" target="_blank" rel="noreferrer">LudiPassion</a></span>
                        </article>
                        <article>
                            <img src="/img/partenaires/la-crique-aux-jeux.jpg" alt="" width="54" height="54" loading="lazy">
                            <span><a href="https://www.crique-aux-jeux.fr/" target="_blank" rel="noreferrer">La Crique aux jeux</a></span>
                        </article>
                        <article>
                            <img src="/img/partenaires/cartes-sur-table.jpg" alt="" width="54" height="54" loading="lazy">
                            <span><a href="https://www.facebook.com/cartessurtable89" target="_blank" rel="noreferrer">Cartes sur table</a></span>
                        </article>
                    </div>
                </aside>
            </div>
        </section>
    </main>
{% endblock %}
