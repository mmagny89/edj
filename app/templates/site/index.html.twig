<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Envie de Jouer - Association de jeux de société à Joigny{% endblock %}</title>
    <link rel="icon" href="/img/edj-mascotte-transparent.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Akaya+Kanadaka&family=Atkinson+Hyperlegible:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
          crossorigin="anonymous" referrerpolicy="no-referrer"/>
    {% block stylesheets %}
        {{ encore_entry_link_tags('site') }}
    {% endblock %}
</head>
<body>
{% block body %}
    <header class="site-header">
        <a class="brand" href="#accueil" aria-label="Retour à l'accueil">
            <img src="/img/edj-mascotte-transparent.png" alt="" class="brand__mascot">
            <span>
                <strong>Envie de Jouer</strong>
                <small>Joigny</small>
            </span>
        </a>

        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav" data-menu-toggle>
            <i class="fa-solid fa-bars" aria-hidden="true"></i>
            <span>Menu</span>
        </button>

        <nav id="main-nav" class="main-nav" aria-label="Navigation principale" data-main-nav>
            <a href="#calendrier">Calendrier</a>
            <a href="#association">Association</a>
            <a href="#adhesion">Adhésion</a>
            <a href="#partenaires">Partenaires</a>
            <a href="#contact">Contact</a>
        </nav>
    </header>

    <main id="accueil">
        <section class="hero">
            <div class="hero__content">
                <p class="eyebrow">Association de jeux de société modernes à Joigny</p>
                <h1 class="hero-title">
                    <span>Envie de</span>
                    <span class="hero-title__play">
                        <img src="/img/edj-mascotte-transparent.png" alt="" aria-hidden="true">
                        Jouer
                    </span>
                </h1>
                <p class="hero__lead">
                    Des tables toute l'année, une ludothèque généreuse et des rendez-vous réguliers,
                    pour celles et ceux qui aiment découvrir, expliquer, rire, perdre dignement et recommencer.
                </p>

                <div class="hero__actions" aria-label="Actions principales">
                    <a href="#calendrier" class="button button--primary">
                        <i class="fa-solid fa-calendar-days" aria-hidden="true"></i>
                        Voir les prochaines dates
                    </a>
                    <a href="mailto:enviedejouer89300@gmail.com" class="button button--quiet">
                        <i class="fa-solid fa-envelope" aria-hidden="true"></i>
                        Nous contacter
                    </a>
                </div>

                <div class="hero-pills" aria-label="Informations rapides">
                    <span><i class="fa-solid fa-location-dot" aria-hidden="true"></i> Maison des Associations, Joigny</span>
                    <span><i class="fa-solid fa-dice" aria-hidden="true"></i> Tous les mardis soir</span>
                    <span><i class="fa-solid fa-calendar-day" aria-hidden="true"></i> 3e samedi du mois</span>
                </div>
            </div>

            <aside class="next-event" aria-labelledby="next-event-title">
                <span class="next-event__label">Prochain rendez-vous</span>
                <h2 id="next-event-title" data-next-event-title>Soirée jeux du mardi</h2>
                <p class="next-event__date" data-next-event-date>Tous les mardis</p>
                <p data-next-event-meta>De 18h30 à minuit. L'adhésion se prend sur place.</p>
                <a href="#calendrier">Voir les prochaines dates</a>
            </aside>

        </section>

        <section id="calendrier" class="section section--calendar">
            <div class="section__intro">
                <p class="eyebrow">Calendrier</p>
                <h2>Les prochaines dates</h2>
                <p>
                    Repère ton créneau, prépare la prochaine table et viens jouer : les soirées du mardi
                    et les après-midi du 3e samedi rassemblent les adhérents autour de la ludothèque,
                    tout au long de la saison.
                </p>
            </div>

            <div class="event-carousel" data-event-carousel>
                <div class="calendar-toolbar" aria-label="Filtrer les événements">
                    <button class="calendar-filter is-active" type="button" data-filter="all">Tous</button>
                    <button class="calendar-filter" type="button" data-filter="weekly">Mardis</button>
                    <button class="calendar-filter" type="button" data-filter="monthly">3e samedis</button>
                    <button class="calendar-filter" type="button" data-filter="special">Manifestations</button>
                </div>

                <div class="carousel-controls" aria-label="Navigation du carrousel">
                    <button type="button" data-carousel-prev aria-label="Événements précédents">
                        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                    </button>
                    <button type="button" data-carousel-next aria-label="Événements suivants">
                        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="event-track" data-event-track aria-live="polite"></div>
            </div>
        </section>

        <section id="association" class="section association-section">
            <div class="section__intro">
                <p class="eyebrow">L'association</p>
                <h2>Une ludothèque vivante à Joigny</h2>
                <p>
                    Créée en 2023, Envie de Jouer rassemble des passionnés de jeux de société
                    autour de soirées régulières, d'après-midi ludiques et de manifestations.
                </p>
            </div>

            <div class="stats-grid" aria-label="Chiffres clés">
                <article>
                    <strong class="counter" data-count="2023">0</strong>
                    <span>création</span>
                </article>
                <article>
                    <strong class="counter" data-count="70">0</strong>
                    <span>adhérents 2025</span>
                </article>
                <article>
                    <strong class="counter" data-count="1300">0</strong>
                    <span>jeux dans les ludothèques de nos membres</span>
                </article>
                <article>
                    <strong class="counter" data-count="110">0</strong>
                    <span>soirées adhérents</span>
                </article>
                <article>
                    <strong class="counter" data-count="125">0</strong>
                    <span>événements déjà organisés</span>
                </article>
            </div>
        </section>

        <section id="adhesion" class="section membership">
            <div class="section__intro">
                <p class="eyebrow">Adhésion</p>
                <h2>Rejoindre l'association</h2>
                <p>
                    L'adhésion ouvre l'ensemble de nos rendez-vous — soirées du mardi, après-midi du
                    3e samedi, grands événements de la saison — et l'accès à la vie associative.
                    Elle court du 1er octobre au 30 septembre suivant.
                </p>
            </div>

            <div class="membership__content">
                <div class="membership-season">
                    <i class="fa-solid fa-calendar-check" aria-hidden="true"></i>
                    <h3>Saison associative</h3>
                    <p>Du <strong>1er octobre</strong> au <strong>30 septembre</strong> suivant.</p>
                </div>

                <div class="membership-benefits">
                    <h3>Ce que l'adhésion permet</h3>
                    <ul>
                        <li>Participer aux soirées du mardi dès 18h30.</li>
                        <li>Rejoindre les après-midi ludiques du 3e samedi.</li>
                        <li>Profiter de la ludothèque et des explications autour des tables.</li>
                        <li>Prendre part aux rendez-vous et à la vie de l'association.</li>
                    </ul>
                </div>

                <div class="membership-prices">
                    <article>
                        <span>Individuelle</span>
                        <strong>10 €</strong>
                    </article>
                    <article>
                        <span>Famille</span>
                        <strong>10 € <small>+ 5 € / pers. suppl.</small></strong>
                    </article>
                    <article>
                        <span>Consommateur</span>
                        <strong>Gratuite <small>+ 1 € / événement</small></strong>
                    </article>
                </div>

                <div class="membership-files">
                    <h3>Documents</h3>
                    <div class="document-links">
                        <a href="/fiche_adhesion.pdf"><i class="fa-solid fa-download" aria-hidden="true"></i> Fiche d'adhésion</a>
                        <a href="/statuts.pdf"><i class="fa-solid fa-file-lines" aria-hidden="true"></i> Statuts</a>
                        <a href="/reglement_interieur.pdf"><i class="fa-solid fa-scroll" aria-hidden="true"></i> Règlement intérieur</a>
                        <a href="/annexes.pdf"><i class="fa-solid fa-paperclip" aria-hidden="true"></i> Annexes</a>
                    </div>
                </div>
            </div>
        </section>

        <section class="section mascot-section">
            <div>
                <p class="eyebrow">Mascotte</p>
                <h2>Perceval, le chevalier des jeux</h2>
                <p>
                    Son nom s'inspire de la série Kaamelott, d'Alexandre Astier, et en particulier du
                    personnage Perceval, connu pour expliquer des jeux de manière parfois farfelue.
                </p>
                <p>
                    Le choix d'un chevalier évoque le riche passé historique de Joigny, marqué par son
                    héritage médiéval et par des périodes influencées par des présences militaires d'autrefois.
                </p>
                <p>
                    Perceval, aux couleurs de Joigny, vert, bleu et blanc, porte fièrement son casque,
                    un dé de 6 et un bouclier orné du maillet emblématique de la ville.
                </p>
            </div>
            <img src="/img/edj-mascotte-transparent.png" alt="Perceval, mascotte chevalier d'Envie de Jouer">
        </section>

        <section id="contact" class="section contact-section">
            <div class="contact-layout">
                <div>
                    <div class="section__intro">
                        <p class="eyebrow">Contact</p>
                        <h2>Une question, une envie de passer ?</h2>
                        <p>Le plus simple : nous écrire ou suivre les annonces des prochaines manifestations.</p>
                    </div>

                    <div class="contact-actions">
                        <a href="mailto:enviedejouer89300@gmail.com" class="button button--primary">
                            <i class="fa-solid fa-envelope" aria-hidden="true"></i>
                            enviedejouer89300@gmail.com
                        </a>
                        <a href="https://www.facebook.com/EnviedeJouer89/" target="_blank" rel="noreferrer" class="button button--social">
                            <i class="fa-brands fa-facebook-f" aria-hidden="true"></i>
                            Facebook
                        </a>
                        <a href="https://www.instagram.com/envie_de_jouer_89/" target="_blank" rel="noreferrer" class="button button--social">
                            <i class="fa-brands fa-instagram" aria-hidden="true"></i>
                            Instagram
                        </a>
                    </div>
                </div>

                <aside id="partenaires" class="partners-panel">
                    <p class="eyebrow">Partenaires</p>
                    <h2>Ils jouent avec nous</h2>
                    <p>Un espace prêt pour intégrer les logos des partenaires.</p>
                    <div class="partners-list" aria-label="Liste des partenaires">
                        <article>
                            <img src="/img/edj-mascotte-transparent.png" alt="">
                            <span>Ville de Joigny</span>
                        </article>
                        <article>
                            <img src="/img/edj-mascotte-transparent.png" alt="">
                            <span>Sens Ludique</span>
                        </article>
                        <article>
                            <img src="/img/edj-mascotte-transparent.png" alt="">
                            <span>LudiPassion</span>
                        </article>
                        <article>
                            <img src="/img/edj-mascotte-transparent.png" alt="">
                            <span>La Crique aux jeux</span>
                        </article>
                        <article>
                            <img src="/img/edj-mascotte-transparent.png" alt="">
                            <span>Carte sur table</span>
                        </article>
                    </div>
                </aside>
            </div>
        </section>
    </main>

    <footer class="site-footer">
        <span>© {{ "now" | date('Y') }} Envie de Jouer - Joigny</span>
        <a href="/mentions-legales">Mentions légales</a>
    </footer>
{% endblock %}
{% block javascripts %}
    {{ encore_entry_script_tags('site') }}
{% endblock %}
</body>
</html>
