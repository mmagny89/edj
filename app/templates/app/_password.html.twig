{#- Champ mot de passe double d'un oeil d'affichage. Un seul endroit pour la
    connexion, le changement de mot de passe et tout champ a venir : la
    mecanique du bouton (cache dans le HTML, revele par Stimulus) ne doit pas
    se recopier d'un gabarit a l'autre. -#}
{% import 'app/_icons.html.twig' as ui %}

{% macro toggle() %}
    {% import 'app/_icons.html.twig' as ui %}
    <button type="button" hidden
            class="absolute inset-y-0 right-0 flex items-center rounded-r-lg px-3 text-slate-600 hover:text-ink focus:text-ink"
            data-password-toggle-target="button" data-action="password-toggle#toggle"
            aria-pressed="false">
        <span data-password-toggle-target="show">{{ ui.icon('eye') }}</span>
        <span data-password-toggle-target="hide" hidden>{{ ui.icon('eye-slash') }}</span>
        <span class="sr-only">Afficher le mot de passe</span>
    </button>
{% endmacro %}
