{% extends 'app/layout.html.twig' %}
{% import 'app/_icons.html.twig' as ui %}

{% block title %}Évènements - Envie de Jouer{% endblock %}

{% block content %}
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold text-ink">Évènements</h1>
            <p class="mt-1 text-slate-600">Ce que vous saisissez ici apparaît dans le calendrier de la page d'accueil.</p>
        </div>
        <div class="flex flex-wrap gap-3">
            <a href="{{ path('app_event_generate') }}" class="btn btn-secondary">{{ ui.icon('sparkles') }} Générer la saison</a>
            <a href="{{ path('app_event_new') }}" class="btn btn-primary">{{ ui.icon('plus') }} Ajouter un évènement</a>
        </div>
    </div>

    <section class="card mt-8" aria-labelledby="titre-liste">
        <h2 id="titre-liste" class="border-b border-slate-100 px-5 py-4 text-lg font-bold text-ink">
            Au calendrier <span class="font-medium text-slate-500">{{ events|length }}</span>
        </h2>

        {% if events is empty %}
            <p class="px-5 py-8 text-slate-600">
                Aucun évènement saisi — le calendrier de la page d'accueil est donc vide.
                « Générer la saison » crée d'un coup toutes les soirées du mardi et tous les
                après-midi du 1er samedi de la période choisie.
            </p>
        {% else %}
            <div class="relative overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-600">
                        <tr>
                            <th scope="col" class="px-5 py-3 font-semibold">Date</th>
                            <th scope="col" class="px-3 py-3 font-semibold">Évènement</th>
                            <th scope="col" class="px-3 py-3 font-semibold">Type</th>
                            <th scope="col" class="px-3 py-3 font-semibold">Horaire</th>
                            <th scope="col" class="px-5 py-3 text-right font-semibold">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for event in events %}
                            {% set past = event.lastDay < today %}
                            <tr class="{{ past ? 'bg-slate-50/60 text-slate-500' }}">
                                <td class="whitespace-nowrap px-5 py-3 align-top">
                                    <div class="font-semibold {{ past ? '' : 'text-slate-800' }}">{{ event.startsAt|date('d/m/Y') }}</div>
                                    {% if event.endsAt %}
                                        <div class="text-xs">jusqu'au {{ event.endsAt|date('d/m/Y') }}</div>
                                    {% endif %}
                                    {% if past %}
                                        <span class="badge mt-1 bg-slate-200 text-slate-600">passé</span>
                                    {% endif %}
                                </td>

                                <td class="px-3 py-3 align-top">
                                    <div class="font-semibold {{ past ? '' : 'text-slate-800' }}">{{ event.title }}</div>
                                    {% if event.location %}
                                        <div class="text-xs">{{ event.location }}</div>
                                    {% endif %}
                                    {% if event.description %}
                                        <div class="mt-1 max-w-md text-xs">{{ event.description }}</div>
                                    {% endif %}
                                </td>

                                <td class="whitespace-nowrap px-3 py-3 align-top">
                                    <span class="badge bg-blue-100 text-blue-900">{{ event.type.label }}</span>
                                </td>

                                <td class="whitespace-nowrap px-3 py-3 align-top">{{ event.timeLabel }}</td>

                                <td class="px-5 py-3 align-top">
                                    <div class="flex items-center justify-end gap-2">
                                        <a href="{{ path('app_event_edit', {id: event.id}) }}" class="btn btn-secondary">
                                            {{ ui.icon('pencil') }} Modifier<span class="sr-only"> {{ event.title }}</span>
                                        </a>
                                        <form method="post" action="{{ path('app_event_delete', {id: event.id}) }}"
                                              data-controller="confirm"
                                              data-confirm-message-value="Supprimer « {{ event.title }} » ? Cette action est définitive."
                                              data-action="submit->confirm#ask">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_event_' ~ event.id) }}">
                                            <button type="submit" class="btn btn-danger">
                                                {{ ui.icon('trash') }} Supprimer<span class="sr-only"> {{ event.title }}</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>

    <p class="mt-4 text-sm text-slate-600">Les évènements terminés sont supprimés automatiquement chaque nuit.</p>
{% endblock %}
