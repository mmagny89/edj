{% extends 'app/layout.html.twig' %}

{% block title %}Évènements - Envie de jouer{% endblock %}

{% block body %}
    <div class="sm:flex sm:justify-between sm:items-center mb-8">
        <div>
            <h1 class="text-2xl md:text-3xl text-gray-800 dark:text-gray-100 font-bold">Évènements</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
                Ce que vous saisissez ici apparaît dans le calendrier de la page d'accueil.
            </p>
        </div>
        <a href="{{ path('app_event_new') }}"
           class="btn bg-violet-500 hover:bg-violet-600 text-white inline-flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium">
            <svg class="fill-current shrink-0" width="16" height="16" viewBox="0 0 16 16">
                <path d="M15 7H9V1a1 1 0 0 0-2 0v6H1a1 1 0 0 0 0 2h6v6a1 1 0 0 0 2 0V9h6a1 1 0 0 0 0-2Z"/>
            </svg>
            Ajouter un évènement
        </a>
    </div>

    <div class="bg-white dark:bg-gray-800 shadow-xs rounded-xl">
        <header class="px-5 py-4 border-b border-gray-100 dark:border-gray-700/60">
            <h2 class="font-semibold text-gray-800 dark:text-gray-100">
                Au calendrier <span class="text-gray-400 dark:text-gray-500 font-medium">{{ events|length }}</span>
            </h2>
        </header>

        {% if events is empty %}
            <p class="px-5 py-8 text-sm text-gray-500 dark:text-gray-400">
                Aucun évènement saisi. Les soirées du mardi et les après-midi du 3e samedi
                restent affichées sur le site : elles sont calculées automatiquement.
            </p>
        {% else %}
            <div class="overflow-x-auto">
                <table class="table-auto w-full dark:text-gray-300">
                    <thead class="text-xs font-semibold uppercase text-gray-400 dark:text-gray-500 bg-gray-50 dark:bg-gray-900/20">
                        <tr>
                            <th class="p-2 first:pl-5 whitespace-nowrap"><div class="font-semibold text-left">Date</div></th>
                            <th class="p-2 whitespace-nowrap"><div class="font-semibold text-left">Évènement</div></th>
                            <th class="p-2 whitespace-nowrap"><div class="font-semibold text-left">Type</div></th>
                            <th class="p-2 whitespace-nowrap"><div class="font-semibold text-left">Horaire</div></th>
                            <th class="p-2 last:pr-5 whitespace-nowrap"><div class="font-semibold text-right">Actions</div></th>
                        </tr>
                    </thead>
                    <tbody class="text-sm divide-y divide-gray-100 dark:divide-gray-700/60">
                        {% for event in events %}
                            {% set past = event.lastDay < today %}
                            <tr class="{{ past ? 'opacity-50' }}">
                                <td class="p-2 first:pl-5 whitespace-nowrap align-top">
                                    <div class="font-medium text-gray-800 dark:text-gray-100">
                                        {{ event.startsAt|date('d/m/Y') }}
                                    </div>
                                    {% if event.endsAt %}
                                        <div class="text-xs text-gray-500 dark:text-gray-400">
                                            jusqu'au {{ event.endsAt|date('d/m/Y') }}
                                        </div>
                                    {% endif %}
                                    {% if past %}
                                        <span class="inline-flex text-xs font-medium rounded-full px-2 py-0.5 bg-gray-500/20 text-gray-600 mt-1">passé</span>
                                    {% endif %}
                                </td>

                                <td class="p-2 align-top">
                                    <div class="font-medium text-gray-800 dark:text-gray-100">{{ event.title }}</div>
                                    {% if event.location %}
                                        <div class="text-xs text-gray-500 dark:text-gray-400">{{ event.location }}</div>
                                    {% endif %}
                                    {% if event.description %}
                                        <div class="text-xs text-gray-400 dark:text-gray-500 mt-1">{{ event.description }}</div>
                                    {% endif %}
                                </td>

                                <td class="p-2 align-top whitespace-nowrap">
                                    <span class="inline-flex text-xs font-medium rounded-full px-2.5 py-0.5 bg-violet-500/20 text-violet-700">
                                        {{ event.type.label }}
                                    </span>
                                </td>

                                <td class="p-2 align-top whitespace-nowrap text-gray-600 dark:text-gray-400">{{ event.timeLabel }}</td>

                                <td class="p-2 last:pr-5 align-top">
                                    <div class="flex justify-end items-center gap-3">
                                        <a class="text-violet-500 hover:underline" href="{{ path('app_event_edit', {id: event.id}) }}">Modifier</a>
                                        <form method="post" action="{{ path('app_event_delete', {id: event.id}) }}"
                                              onsubmit="return confirm('Supprimer « {{ event.title|e('js') }} » ? Cette action est définitive.');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_event_' ~ event.id) }}">
                                            <button type="submit" class="text-red-500 hover:underline">Supprimer</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

    <p class="text-xs text-gray-400 dark:text-gray-500 mt-4">
        Les évènements terminés sont supprimés automatiquement chaque nuit.
    </p>
{% endblock %}
