{% extends 'app/layout.html.twig' %}

{% form_theme form 'app/form_theme.html.twig' %}

{% block title %}{{ isNew ? 'Nouvel évènement' : 'Modifier un évènement' }} - Envie de Jouer{% endblock %}

{% block content %}
    <a href="{{ path('app_events') }}" class="text-sm font-semibold text-brand underline underline-offset-4 hover:text-brand-dark">← Retour aux évènements</a>
    <h1 class="mt-3 text-3xl font-bold text-ink">
        {{ isNew ? 'Nouvel évènement' : 'Modifier « ' ~ event.title ~ ' »' }}
    </h1>

    <div class="card mt-8 max-w-3xl p-6">
        {{ form_start(form, {attr: {class: 'space-y-6', novalidate: 'novalidate'}}) }}
            {{ form_errors(form) }}

            {{ form_row(form.title) }}
            {{ form_row(form.type) }}

            <div class="grid gap-6 sm:grid-cols-2">
                {{ form_row(form.startsAt) }}
                {{ form_row(form.endsAt) }}
                {{ form_row(form.timeLabel) }}
                {{ form_row(form.location) }}
            </div>

            {{ form_row(form.description) }}

            <div class="flex flex-wrap items-center gap-3 pt-2">
                <button type="submit" class="btn btn-primary">{{ isNew ? "Ajouter l'évènement" : 'Enregistrer' }}</button>
                <a href="{{ path('app_events') }}" class="btn btn-secondary">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
