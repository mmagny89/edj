{% extends 'app/layout.html.twig' %}
{% import 'app/_icons.html.twig' as ui %}

{% form_theme form 'app/form_theme.html.twig' %}

{% block title %}{{ isNew ? 'Nouvel évènement' : 'Modifier un évènement' }} - Envie de Jouer{% endblock %}

{% block content %}
    <a href="{{ path('app_events') }}" class="inline-flex min-h-11 items-center gap-1.5 py-2 text-sm font-semibold text-brand underline underline-offset-4 hover:text-brand-dark">{{ ui.icon('arrow-left', 'size-4') }} Retour aux évènements</a>
    <h1 class="mt-3 text-3xl font-bold text-ink">
        {{ isNew ? 'Nouvel évènement' : 'Modifier « ' ~ event.title ~ ' »' }}
    </h1>

    <div class="card mt-8 max-w-3xl p-6">
        {{ form_start(form, {attr: {class: 'space-y-6', novalidate: 'novalidate'}}) }}
            {{ form_errors(form) }}

            {{ form_row(form.title) }}
            {{ form_row(form.type) }}

            <div class="grid gap-6 sm:grid-cols-2">
                {{ form_row(form.startsAt) }}
                {{ form_row(form.endsAt) }}
                {{ form_row(form.timeLabel) }}
                {{ form_row(form.location) }}
            </div>

            {{ form_row(form.description) }}

            <div class="flex flex-wrap items-center gap-3 pt-2">
                <button type="submit" class="btn btn-primary">{{ ui.icon('check') }} {{ isNew ? "Ajouter l'évènement" : 'Enregistrer' }}</button>
                <a href="{{ path('app_events') }}" class="btn btn-secondary">{{ ui.icon('x') }} Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
