{% extends 'app/layout.html.twig' %}
{% import 'app/_icons.html.twig' as ui %}

{% form_theme form 'app/form_theme.html.twig' %}

{% block title %}Générer la saison - Envie de Jouer{% endblock %}

{% block content %}
    <a href="{{ path('app_events') }}" class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand underline underline-offset-4 hover:text-brand-dark">{{ ui.icon('arrow-left', 'size-4') }} Retour aux évènements</a>
    <h1 class="mt-3 text-3xl font-bold text-ink">Générer la saison</h1>
    <p class="mt-1 max-w-2xl text-slate-500">
        Crée d'un coup toutes les dates qui reviennent, sur la période choisie. La période
        proposée va d'aujourd'hui à la fin de la saison à préparer — la suivante, dès que
        la saison en cours touche à sa fin.
    </p>

    <div class="card mt-8 max-w-2xl p-6">
        {{ form_start(form, {attr: {class: 'space-y-6', novalidate: 'novalidate'}}) }}
            {{ form_errors(form) }}

            <div class="grid gap-6 sm:grid-cols-2">
                {{ form_row(form.from) }}
                {{ form_row(form.to) }}
            </div>

            <fieldset class="space-y-3">
                <legend class="mb-2 text-sm font-semibold text-slate-800">Ce qu'il faut générer</legend>
                {{ form_row(form.weekly) }}
                {{ form_row(form.monthly) }}
            </fieldset>

            <div class="rounded-lg bg-slate-50 px-4 py-3 text-sm text-slate-600">
                <p class="font-semibold text-slate-800">Ce qui sera créé</p>
                <p class="mt-1">
                    Chaque date devient un évènement ordinaire, avec son titre, son horaire et son lieu
                    habituels — modifiable ou supprimable ensuite une par une, sans toucher aux autres.
                    Les jours fériés sont ignorés.
                </p>
                <p class="mt-2">
                    Relancer la génération sur une période déjà couverte ne crée rien en double :
                    les dates déjà présentes sont laissées telles quelles.
                </p>
            </div>

            <div class="flex flex-wrap items-center gap-3 pt-2">
                <button type="submit" class="btn btn-primary">{{ ui.icon('sparkles') }} Générer les dates</button>
                <a href="{{ path('app_events') }}" class="btn btn-secondary">{{ ui.icon('x') }} Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
