{% extends 'app/layout.html.twig' %}
{% import 'app/_icons.html.twig' as ui %}

{% block title %}{{ campaign.subject }} - Envie de Jouer{% endblock %}

{% block content %}
    <a href="{{ path('app_mailing') }}" class="inline-flex min-h-11 items-center gap-1.5 py-2 text-sm font-semibold text-brand underline underline-offset-4 hover:text-brand-dark">
        {{ ui.icon('arrow-left', 'size-4') }} Retour aux messages
    </a>
    <h1 class="mt-3 text-3xl font-bold text-ink">{{ campaign.subject }}</h1>
    <p class="mt-1 text-slate-600">
        Envoyé le {{ campaign.sentAt|date('d/m/Y à H:i') }}
        {% if campaign.sentById is not null %}par {{ actors[campaign.sentById] ?? 'un compte supprimé' }}{% endif %}
    </p>

    <section class="card mt-8 max-w-3xl p-6" aria-labelledby="titre-envoi">
        <h2 id="titre-envoi" class="text-lg font-bold text-ink">Ce qui est parti</h2>
        <dl class="mt-3 grid gap-x-6 gap-y-1 text-sm sm:grid-cols-2">
            <div class="flex justify-between gap-4"><dt class="text-slate-600">Saison</dt><dd class="font-semibold">{{ campaign.season - 1 }}-{{ campaign.season }}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-slate-600">Messages mis en file</dt><dd class="font-semibold">{{ campaign.recipientCount }}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-slate-600">Adhérents à l'année</dt><dd class="font-semibold">{{ campaign.includesAnnual ? 'oui' : 'non' }}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-slate-600">Consommateurs</dt><dd class="font-semibold">{{ campaign.includesConsumers ? 'oui' : 'non' }}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-slate-600">Sans adresse e-mail</dt><dd class="font-semibold">{{ campaign.skippedWithoutAddress }}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-slate-600">Désinscrits</dt><dd class="font-semibold">{{ campaign.skippedOptedOut }}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-slate-600">Adresse partagée</dt><dd class="font-semibold">{{ campaign.sharedAddress }}</dd></div>
        </dl>
        <p class="mt-4 text-sm text-slate-600">
            La liste des destinataires n'est pas conservée : elle ne doit pas survivre à l'anonymisation
            des adhésions. Le texte ci-dessous est celui saisi, avec ses variables.
        </p>
    </section>

    <section class="card mt-6 max-w-3xl p-6" aria-labelledby="titre-texte">
        <h2 id="titre-texte" class="text-lg font-bold text-ink">Texte</h2>
        <div class="mt-3 whitespace-pre-line text-sm text-slate-800">{{ campaign.body }}</div>
    </section>
{% endblock %}
