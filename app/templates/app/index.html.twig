{% extends 'app/layout.html.twig' %}
{% import 'app/_icons.html.twig' as ui %}

{% block title %}Tableau de bord - Envie de Jouer{% endblock %}

{% block content %}
    <h1 class="text-3xl font-bold text-ink">Tableau de bord</h1>
    <p class="mt-1 text-slate-600">Bonjour. Voici l'essentiel de ce qui se passe à l'association.</p>


    {# Chiffres d'une saison. Tout se compte sur les bulletins VALIDES : un
       bulletin depose mais non encaisse n'est pas une adhesion, et l'annoncer
       comme telle donnerait au conseil d'administration des effectifs qu'il
       n'a pas. #}
    {% import 'app/charts/_charts.html.twig' as viz %}

    {# Le filtre de saison : une seule ligne, au-dessus de tout ce qu'il regit.
       Choisir une colonne du graphique des saisons fait la meme chose. #}
    <form method="get" action="{{ path('app_index') }}" class="mt-8 flex flex-wrap items-end gap-3" aria-label="Saison affichée">
        <div>
            <label for="s-saison" class="mb-1.5 block text-sm font-semibold text-slate-800">Saison</label>
            <select name="saison" id="s-saison" class="block min-h-11 rounded-lg border border-slate-300 bg-white px-3 py-2 text-base focus:border-brand">
                {% for s in seasons %}
                    <option value="{{ s }}" {{ s == season ? 'selected' }}>{{ s }}{{ s == currentSeason ? ' (en cours)' }}</option>
                {% endfor %}
            </select>
        </div>
        <button type="submit" class="btn btn-secondary">{{ ui.icon('eye') }} Afficher</button>
        <p class="pb-2 text-sm text-slate-600">Du 1<sup>er</sup> octobre {{ season - 1 }} au 30 septembre {{ season }}, adhésions validées.</p>
    </form>

    <section class="mt-6" aria-labelledby="titre-stats">
        <h2 id="titre-stats" class="sr-only">Chiffres de la saison {{ season }}</h2>

        <div class="grid gap-4 lg:grid-cols-3">
            {# Le chiffre en vedette : un seul par page. Le delta dit son sens par le
               signe et par les mots, pas par la seule couleur. #}
            <div class="card flex flex-col justify-center p-6 lg:col-span-1">
                <p class="text-sm font-semibold text-slate-600">Adhérents à l'année · saison {{ season }}</p>
                <p class="mt-1 text-6xl font-bold leading-none text-ink">{{ stats.active }}</p>
                {% if previousActive is not null %}
                    {% set delta = stats.active - previousActive %}
                    {# Le signe et les mots disent le sens : la couleur ne le porte pas seule. #}
                    <p class="mt-3 text-sm text-slate-700">
                        <strong class="{{ delta > 0 ? 'text-green-800' : (delta < 0 ? 'text-red-800' : 'text-slate-700') }}">
                            {{ delta > 0 ? '+' ~ delta : (delta < 0 ? '−' ~ (-delta) : 'Aucun écart') }}
                        </strong>
                        par rapport à la saison {{ season - 1 }}
                        <span class="text-slate-500">({{ previousActive }} adhérents)</span>
                    </p>
                {% else %}
                    <p class="mt-3 text-sm text-slate-600">Pas de saison précédente à comparer.</p>
                {% endif %}
            </div>

            <dl class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:col-span-2">
                {% set chiffres = [
                    {label: 'Consommateurs', value: stats.consumers, hint: '1 € par évènement'},
                    {label: 'Nouveaux', value: stats.newcomers, hint: 'première adhésion'},
                    {label: 'Renouvellements', value: stats.renewals, hint: 'déjà adhérents avant'},
                    {label: 'Mineurs', value: stats.minors, hint: 'au 1er octobre'},
                    {label: 'Âge moyen', value: stats.averageAge is null ? '—' : stats.averageAge|number_format(1, ',', ' ') ~ ' ans', hint: 'au 1er octobre'},
                    {label: 'En attente', value: stats.pending, hint: stats.cancelled ~ ' annulée(s)'},
                ] %}
                {% for chiffre in chiffres %}
                    <div class="card px-4 py-3">
                        <dt class="text-sm font-semibold text-slate-600">{{ chiffre.label }}</dt>
                        <dd class="mt-0.5 text-3xl font-bold text-ink">{{ chiffre.value }}</dd>
                        <p class="text-xs text-slate-600">{{ chiffre.hint }}</p>
                    </div>
                {% endfor %}
            </dl>
        </div>

        <div class="mt-6 grid gap-6 lg:grid-cols-2">
            <div class="card p-6 lg:col-span-2">
                {{ viz.columns(charts.trend, 'Adhérents par saison', "Cliquez sur une saison pour l'ouvrir. Nouveaux, renouvellements et consommateurs.") }}
            </div>

            <div class="card p-6">
                {{ viz.line(charts.cumulative, 'Au fil de la saison', "Adhérents à l'année cumulés mois par mois, d'octobre à septembre, contre la saison précédente.") }}
            </div>

            <div class="card p-6">
                {{ viz.columns(charts.ages, 'Âges', "Âge au 1er octobre de la saison, consommateurs compris.") }}
            </div>

            <div class="card p-6">
                {{ viz.bars(charts.geography, "D'où viennent-ils ?", 'Commune du bulletin. Un bulletin anonymisé n\'a plus de commune : il figure en « non renseigné ».') }}
            </div>

            <div class="card p-6">
                {{ viz.bars(charts.types, 'Formules', 'Adhésions validées de la saison, par formule.') }}
            </div>

            <div class="card p-6">
                {{ viz.bars(charts.payments, 'Moyens de règlement', '« Gratuit » : rien n\'était dû — un enfant de moins de huit ans, ou la formule consommateur.') }}
            </div>

            <div class="card p-6">
                <h3 class="viz-title">Autorisations</h3>
                <p class="viz-caption">Ce que les adhérents ont accepté ou refusé sur leur bulletin.</p>
                <div class="mt-4 space-y-5">
                    {{ viz.meter(charts.photos) }}
                    {{ viz.meter(charts.philibert) }}
                </div>
            </div>
        </div>
    </section>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
        <section class="card p-6" aria-labelledby="titre-prochains">
            <h2 id="titre-prochains" class="text-lg font-bold text-ink">Prochains rendez-vous</h2>

            {% if upcoming is empty %}
                <p class="mt-3 text-sm text-slate-600">Aucun évènement au calendrier.</p>
            {% else %}
                <ul class="mt-4 divide-y divide-slate-100">
                    {% for event in upcoming %}
                        <li class="flex items-baseline justify-between gap-4 py-2.5">
                            <span class="font-semibold text-slate-800">{{ event.title }}</span>
                            <time datetime="{{ event.startsAt|date('Y-m-d') }}" class="shrink-0 text-sm text-slate-600">
                                {{ event.startsAt|date('d/m/Y') }}
                            </time>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}

            <div class="mt-5 flex flex-wrap gap-3">
                <a href="{{ path('app_events') }}" class="btn btn-secondary">{{ ui.icon('calendar') }} Voir le calendrier</a>
                <a href="{{ path('app_event_new') }}" class="btn btn-primary">{{ ui.icon('plus') }} Ajouter un évènement</a>
            </div>
        </section>

        <section class="card p-6" aria-labelledby="titre-adhesions">
            <h2 id="titre-adhesions" class="text-lg font-bold text-ink">Adhésions</h2>
            <p class="mt-4 text-5xl font-bold text-brand">{{ applicationCount }}</p>
            <p class="mt-1 text-sm text-slate-600">
                {{ applicationCount == 1 ? 'bulletin déposé' : 'bulletins déposés' }} depuis le site.
            </p>
            {% if pendingCount > 0 %}
                <p class="mt-3 text-sm font-semibold text-amber-900">
                    {{ pendingCount }} {{ pendingCount == 1 ? 'bulletin attend' : 'bulletins attendent' }} une validation.
                </p>
            {% endif %}
            <div class="mt-5">
                <a href="{{ path('app_membership_applications') }}" class="btn btn-secondary">{{ ui.icon('users') }} Consulter les bulletins</a>
            </div>
        </section>
    </div>
{% endblock %}
