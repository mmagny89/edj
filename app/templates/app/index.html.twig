{% extends 'app/layout.html.twig' %}
{% import 'app/_icons.html.twig' as ui %}

{% block title %}Tableau de bord - Envie de Jouer{% endblock %}

{% block content %}
    <h1 class="text-3xl font-bold text-ink">Tableau de bord</h1>
    <p class="mt-1 text-slate-600">Bonjour. Voici l'essentiel de ce qui se passe à l'association.</p>


    {# Chiffres d'une saison. Tout se compte sur les bulletins VALIDES : un
       bulletin depose mais non encaisse n'est pas une adhesion, et l'annoncer
       comme telle donnerait au conseil d'administration des effectifs qu'il
       n'a pas. Les deux limites de lecture sont dites a l'ecran plutot que
       tues. #}
    <section class="card mt-8 p-6" aria-labelledby="titre-stats">
        <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
                <h2 id="titre-stats" class="text-lg font-bold text-ink">Chiffres de la saison {{ season }}</h2>
                <p class="mt-1 text-sm text-slate-600">
                    Du 1<sup>er</sup> octobre {{ season - 1 }} au 30 septembre {{ season }}, sur les adhésions validées.
                </p>
            </div>

            <form method="get" action="{{ path('app_index') }}" class="flex flex-wrap items-end gap-3">
                <div>
                    <label for="s-saison" class="mb-1.5 block text-sm font-semibold text-slate-800">Saison</label>
                    <select name="saison" id="s-saison" class="block min-h-11 rounded-lg border border-slate-300 px-3 py-2 text-base focus:border-brand">
                        {% for s in seasons %}
                            <option value="{{ s }}" {{ s == season ? 'selected' }}>{{ s }}</option>
                        {% endfor %}
                    </select>
                </div>
                <button type="submit" class="btn btn-secondary">{{ ui.icon('eye') }} Afficher</button>
            </form>
        </div>

        <dl class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {% set chiffres = [
                {label: 'Adhérents à l\'année', value: stats.active, hint: 'cotisation réglée'},
                {label: 'Consommateurs', value: stats.consumers, hint: '1 € par évènement'},
                {label: 'Mineurs', value: stats.minors, hint: 'au 1er octobre'},
                {label: 'Âge moyen', value: stats.averageAge is null ? '—' : stats.averageAge|number_format(1, ',', ' ') ~ ' ans', hint: 'au 1er octobre'},
                {label: 'Renouvellements', value: stats.renewals, hint: 'déjà adhérents avant'},
                {label: 'Nouveaux', value: stats.newcomers, hint: 'première adhésion'},
                {label: 'En attente', value: stats.pending, hint: 'non encaissées'},
                {label: 'Annulées', value: stats.cancelled, hint: 'sur la saison'},
            ] %}
            {% for chiffre in chiffres %}
                <div class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-3">
                    <dt class="text-sm font-semibold text-slate-600">{{ chiffre.label }}</dt>
                    <dd class="mt-1 text-3xl font-bold text-brand">{{ chiffre.value }}</dd>
                    <p class="text-xs text-slate-600">{{ chiffre.hint }}</p>
                </div>
            {% endfor %}
        </dl>

        <h3 class="mt-8 text-base font-bold text-ink">D'où viennent les adhérents</h3>
        <dl class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {% set lieux = [
                {label: 'Joigny', value: stats.geography.joigny},
                {label: 'Communauté de communes', value: stats.geography.intercommunality},
                {label: 'Hors territoire', value: stats.geography.outside},
                {label: 'Non renseigné', value: stats.geography.unknown},
            ] %}
            {% for lieu in lieux %}
                <div class="rounded-lg border border-slate-200 px-4 py-3">
                    <dt class="text-sm font-semibold text-slate-600">{{ lieu.label }}</dt>
                    <dd class="mt-1 text-2xl font-bold text-ink">{{ lieu.value }}</dd>
                </div>
            {% endfor %}
        </dl>

        <h3 class="mt-8 text-base font-bold text-ink">Autorisations</h3>
        <dl class="mt-3 grid gap-4 sm:grid-cols-2">
            <div class="rounded-lg border border-slate-200 px-4 py-3">
                <dt class="text-sm font-semibold text-slate-600">Photos refusées</dt>
                <dd class="mt-1 text-2xl font-bold text-ink">{{ stats.imageRightsRefused }}</dd>
            </div>
            <div class="rounded-lg border border-slate-200 px-4 py-3">
                <dt class="text-sm font-semibold text-slate-600">E-mail transmis à Philibert</dt>
                <dd class="mt-1 text-2xl font-bold text-ink">{{ stats.philibertConsent }}</dd>
            </div>
        </dl>

        <p class="mt-6 border-t border-slate-100 pt-4 text-sm text-slate-600">
            Deux limites de lecture : un bulletin anonymisé n'a plus de commune — il compte
            dans les effectifs, jamais dans la répartition géographique —, et son âge est
            connu à l'année près.
            {% if stats.geography.unknown > 0 %}
                Ici, {{ stats.geography.unknown }} bulletin(s) sont dans ce cas.
            {% endif %}
        </p>
    </section>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
        <section class="card p-6" aria-labelledby="titre-prochains">
            <h2 id="titre-prochains" class="text-lg font-bold text-ink">Prochains rendez-vous</h2>

            {% if upcoming is empty %}
                <p class="mt-3 text-sm text-slate-600">Aucun évènement au calendrier.</p>
            {% else %}
                <ul class="mt-4 divide-y divide-slate-100">
                    {% for event in upcoming %}
                        <li class="flex items-baseline justify-between gap-4 py-2.5">
                            <span class="font-semibold text-slate-800">{{ event.title }}</span>
                            <time datetime="{{ event.startsAt|date('Y-m-d') }}" class="shrink-0 text-sm text-slate-600">
                                {{ event.startsAt|date('d/m/Y') }}
                            </time>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}

            <div class="mt-5 flex flex-wrap gap-3">
                <a href="{{ path('app_events') }}" class="btn btn-secondary">{{ ui.icon('calendar') }} Voir le calendrier</a>
                <a href="{{ path('app_event_new') }}" class="btn btn-primary">{{ ui.icon('plus') }} Ajouter un évènement</a>
            </div>
        </section>

        <section class="card p-6" aria-labelledby="titre-adhesions">
            <h2 id="titre-adhesions" class="text-lg font-bold text-ink">Adhésions</h2>
            <p class="mt-4 text-5xl font-bold text-brand">{{ applicationCount }}</p>
            <p class="mt-1 text-sm text-slate-600">
                {{ applicationCount == 1 ? 'bulletin déposé' : 'bulletins déposés' }} depuis le site.
            </p>
            {% if pendingCount > 0 %}
                <p class="mt-3 text-sm font-semibold text-amber-900">
                    {{ pendingCount }} {{ pendingCount == 1 ? 'bulletin attend' : 'bulletins attendent' }} une validation.
                </p>
            {% endif %}
            <div class="mt-5">
                <a href="{{ path('app_membership_applications') }}" class="btn btn-secondary">{{ ui.icon('users') }} Consulter les bulletins</a>
            </div>
        </section>
    </div>
{% endblock %}
