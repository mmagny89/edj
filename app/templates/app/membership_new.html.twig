{% extends 'app/layout.html.twig' %}

{% import 'app/_icons.html.twig' as ui %}
{% form_theme form 'app/form_theme.html.twig' %}

{% block title %}{{ renewal is defined ? 'Renouveler une adhésion' : 'Inscrire un adhérent' }} - Envie de Jouer{% endblock %}

{% block content %}
    {% if renewal is defined %}
        <a href="{{ path('app_membership_show', {id: from.id}) }}" class="inline-flex min-h-11 items-center gap-1.5 py-2 text-sm font-semibold text-brand underline underline-offset-4 hover:text-brand-dark">
            {{ ui.icon('arrow-left', 'size-4') }} Retour à la fiche
        </a>
        <h1 class="mt-3 text-3xl font-bold text-ink">
            Renouveler une adhésion
            <span class="font-mono text-xl font-bold tracking-wider text-brand">{{ renewal.number }}</span>
        </h1>
        <p class="mt-1 max-w-3xl text-slate-600">
            Saison {{ season }}. Les informations viennent du dernier bulletin : relisez-les avec la personne
            et corrigez ce qui a changé. Le renouvellement est enregistré sous le même numéro, comme
            « fiche papier », en attente — validez-le une fois la cotisation encaissée.
        </p>
    {% else %}
        <a href="{{ path('app_membership_applications') }}" class="inline-flex min-h-11 items-center gap-1.5 py-2 text-sm font-semibold text-brand underline underline-offset-4 hover:text-brand-dark">
            {{ ui.icon('arrow-left', 'size-4') }} Retour aux adhésions
        </a>
        <h1 class="mt-3 text-3xl font-bold text-ink">Inscrire un adhérent</h1>
        <p class="mt-1 max-w-3xl text-slate-600">
            Pour une personne qui a rempli une <strong>fiche papier</strong> : recopiez-la ici. Le bulletin est
            enregistré comme « fiche papier », avec votre nom pour mémoire. Conservez la fiche papier signée.
        </p>
    {% endif %}

    <div class="card mt-8 max-w-3xl p-6">
        {{ form_start(form, {attr: {class: 'space-y-8', novalidate: 'novalidate'}}) }}
            {{ form_errors(form) }}

            <fieldset class="space-y-6">
                <legend class="mb-4 text-lg font-bold text-ink">La fiche</legend>
                {{ form_row(form.submittedAt) }}
            </fieldset>

            <fieldset class="space-y-6">
                <legend class="mb-4 text-lg font-bold text-ink">Adhérent</legend>
                <div class="grid gap-6 sm:grid-cols-2">
                    {{ form_row(form.lastName) }}
                    {{ form_row(form.firstName) }}
                    {{ form_row(form.birthDate) }}
                    {{ form_row(form.phone) }}
                </div>
                {{ form_row(form.address) }}
                <div class="grid gap-6 sm:grid-cols-2">
                    {{ form_row(form.postalCode) }}
                    {{ form_row(form.city) }}
                </div>
                {{ form_row(form.email) }}
            </fieldset>

            <fieldset class="space-y-4">
                <legend class="mb-4 text-lg font-bold text-ink">Adhésion</legend>
                <div class="space-y-3">
                    {% for choice in form.membershipType %}
                        <div class="flex items-start gap-3">
                            {{ form_widget(choice, {attr: {class: 'mt-1 size-5 shrink-0 border-slate-300 text-brand'}}) }}
                            {{ form_label(choice, null, {label_attr: {class: 'font-medium'}}) }}
                        </div>
                    {% endfor %}
                </div>
                {{ form_errors(form.membershipType) }}
                {{ form_row(form.principalMemberName) }}
            </fieldset>

            <fieldset class="space-y-4">
                <legend class="mb-4 text-lg font-bold text-ink">Responsable légal <span class="text-sm font-normal text-slate-600">(pour un mineur)</span></legend>
                <div class="grid gap-6 sm:grid-cols-2">
                    {{ form_row(form.guardianLastName) }}
                    {{ form_row(form.guardianFirstName) }}
                </div>
                {{ form_row(form.guardianEmail) }}
            </fieldset>

            <fieldset class="space-y-4">
                <legend class="mb-4 text-lg font-bold text-ink">Autorisations</legend>
                {{ form_row(form.philibertConsent) }}
                {{ form_row(form.imageRightsRefused) }}
            </fieldset>

            <fieldset class="space-y-4 rounded-lg bg-slate-50 p-4">
                <legend class="mb-2 px-1 text-lg font-bold text-ink">Validation</legend>
                {{ form_row(form.paperConfirmed) }}
                {{ form_row(form.sendConfirmation) }}
            </fieldset>

            <div class="flex flex-wrap gap-3 pt-2">
                <button type="submit" class="btn btn-primary">{{ ui.icon('check') }} {{ renewal is defined ? 'Enregistrer le renouvellement' : "Inscrire l'adhérent" }}</button>
                <a href="{{ path('app_membership_applications') }}" class="btn btn-secondary">{{ ui.icon('x') }} Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
