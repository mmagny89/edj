{% extends 'app/shell.html.twig' %}

{% block body %}
    {% set route = app.request.attributes.get('_route') %}

    <a href="#contenu" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:font-semibold">
        Aller au contenu
    </a>

    <header class="bg-ink text-white" data-controller="nav">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3 sm:px-6">
            <a href="{{ path('app_index') }}" class="flex items-center gap-3 font-semibold">
                <img src="/img/edj-mascotte-transparent.png" alt="" class="size-9" width="36" height="36">
                <span>Envie de Jouer <span class="font-normal text-slate-400">· administration</span></span>
            </a>

            {# Cache dans le HTML, revele par le controleur : sans JavaScript, le
               menu reste deplie. #}
            <button type="button" hidden
                    class="btn border-white/30 text-white hover:bg-white/10 md:hidden"
                    data-nav-target="button" data-action="nav#toggle"
                    aria-expanded="false" aria-controls="menu-principal">
                <span aria-hidden="true">☰</span> Menu
            </button>

            <nav id="menu-principal" aria-label="Administration"
                 class="flex w-full flex-col gap-1 md:w-auto md:flex-row md:items-center md:gap-2"
                 data-nav-target="panel">
                {% set items = [
                    {route: 'app_index', label: 'Tableau de bord', active: route == 'app_index'},
                    {route: 'app_events', label: 'Évènements', active: route starts with 'app_event'},
                ] %}
                {% if is_granted('ROLE_SUPER_ADMIN') %}
                    {% set items = items|merge([{route: 'app_membership_applications', label: 'Adhésions', active: route == 'app_membership_applications'}]) %}
                {% endif %}

                {% for item in items %}
                    <a href="{{ path(item.route) }}"
                       class="rounded-lg px-3 py-2.5 text-sm font-semibold {{ item.active ? 'bg-white/15 text-white' : 'text-slate-300 hover:bg-white/10 hover:text-white' }}"
                       {{ item.active ? 'aria-current="page"' }}>
                        {{ item.label }}
                    </a>
                {% endfor %}

                <a href="{{ path('site_index') }}" target="_blank" rel="noopener"
                   class="rounded-lg px-3 py-2.5 text-sm font-semibold text-slate-300 hover:bg-white/10 hover:text-white">
                    Voir le site <span class="sr-only">(nouvel onglet)</span><span aria-hidden="true">↗</span>
                </a>

                <form method="post" action="{{ path('app_logout') }}" class="md:ml-2 md:border-l md:border-white/20 md:pl-4">
                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('logout') }}">
                    <button type="submit" class="w-full rounded-lg px-3 py-2.5 text-left text-sm font-semibold text-slate-300 hover:bg-white/10 hover:text-white md:w-auto">
                        Se déconnecter
                        <span class="sr-only">({{ app.user.userIdentifier }})</span>
                    </button>
                </form>
            </nav>
        </div>
    </header>

    <main id="contenu" class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
        {# Sans ce bloc, un addFlash d'un controleur ne s'affichait nulle part :
           l'action reussissait en silence. #}
        {% for label, messages in app.flashes(['success', 'error']) %}
            {% for message in messages %}
                <div class="mb-6 flex items-start justify-between gap-4 rounded-lg border px-4 py-3 text-sm font-semibold {{ label == 'success'
                        ? 'border-green-300 bg-green-50 text-green-900'
                        : 'border-red-300 bg-red-50 text-red-900' }}"
                     role="{{ label == 'error' ? 'alert' : 'status' }}"
                     data-controller="flash"
                     data-flash-delay-value="{{ label == 'success' ? 6000 : 0 }}">
                    <p>{{ message }}</p>
                    <button type="button" class="-m-1 shrink-0 rounded p-1 hover:bg-black/5" data-action="flash#dismiss">
                        <span class="sr-only">Fermer ce message</span><span aria-hidden="true">✕</span>
                    </button>
                </div>
            {% endfor %}
        {% endfor %}

        {% block content %}{% endblock %}
    </main>
{% endblock %}
