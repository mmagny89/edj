{% extends 'app/layout.html.twig' %}

{% import 'app/_icons.html.twig' as ui %}
{% form_theme form 'app/form_theme.html.twig' %}

{% block title %}Saison {{ stamp.year }} - Envie de Jouer{% endblock %}

{% block content %}
    <a href="{{ path('app_seasons') }}" class="inline-flex min-h-11 items-center gap-1.5 py-2 text-sm font-semibold text-brand underline underline-offset-4 hover:text-brand-dark">
        {{ ui.icon('arrow-left', 'size-4') }} Retour aux saisons
    </a>

    <h1 class="mt-3 text-3xl font-bold text-ink">Saison {{ stamp.year }}</h1>
    <p class="mt-1 max-w-2xl text-slate-600">
        Modifier ce tampon change ce qui est imprimé sur toutes les cartes de cette saison,
        y compris celles que des adhérents ont déjà téléchargées.
    </p>

    <section class="card mt-8 max-w-xl p-6" aria-labelledby="t-tampon">
        <h2 id="t-tampon" class="text-lg font-bold text-ink">Tampon</h2>
        {{ form_start(form, {attr: {class: 'mt-4 space-y-5', novalidate: 'novalidate'}}) }}
            {{ form_errors(form) }}
            {{ form_row(form.year) }}
            {{ form_row(form.symbol) }}
            {{ form_row(form.color) }}
            <button type="submit" class="btn btn-primary">{{ ui.icon('check') }} Enregistrer</button>
        {{ form_end(form) }}
    </section>
{% endblock %}
