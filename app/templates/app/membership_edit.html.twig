{% extends 'app/layout.html.twig' %}

{% import 'app/_icons.html.twig' as ui %}
{% form_theme form 'app/form_theme.html.twig' %}

{% block title %}Corriger la fiche - Envie de Jouer{% endblock %}

{% block content %}
    <a href="{{ path('app_membership_show', {id: application.id}) }}" class="inline-flex min-h-11 items-center gap-1.5 py-2 text-sm font-semibold text-brand underline underline-offset-4 hover:text-brand-dark">
        {{ ui.icon('arrow-left', 'size-4') }} Retour à la fiche
    </a>
    <h1 class="mt-3 text-3xl font-bold text-ink">
        Corriger la fiche
        {% if application.memberNumber %}<span class="font-mono text-xl font-bold tracking-wider text-brand">{{ application.memberNumber }}</span>{% endif %}
    </h1>
    <p class="mt-1 max-w-3xl text-slate-600">
        Corrigez ce qui est faux : nom, coordonnées, autorisations. La formule, la date de la fiche et le
        règlement ne changent pas ici. La correction est notée dans l'historique, sans le détail de ce qui a changé.
    </p>

    <div class="card mt-8 max-w-3xl p-6">
        {{ form_start(form, {attr: {class: 'space-y-8', novalidate: 'novalidate'}}) }}
            {{ form_errors(form) }}

            <fieldset class="space-y-6">
                <legend class="mb-4 text-lg font-bold text-ink">Adhérent</legend>
                <div class="grid gap-6 sm:grid-cols-2">
                    {{ form_row(form.lastName) }}
                    {{ form_row(form.firstName) }}
                    {{ form_row(form.birthDate) }}
                    {{ form_row(form.phone) }}
                </div>
                {{ form_row(form.address) }}
                <div class="grid gap-6 sm:grid-cols-2">
                    {{ form_row(form.postalCode) }}
                    {{ form_row(form.city) }}
                </div>
                {{ form_row(form.email) }}
                {{ form_row(form.principalMemberName) }}
            </fieldset>

            <fieldset class="space-y-4">
                <legend class="mb-4 text-lg font-bold text-ink">Responsable légal <span class="text-sm font-normal text-slate-600">(pour un mineur)</span></legend>
                <div class="grid gap-6 sm:grid-cols-2">
                    {{ form_row(form.guardianLastName) }}
                    {{ form_row(form.guardianFirstName) }}
                </div>
                {{ form_row(form.guardianEmail) }}
            </fieldset>

            <fieldset class="space-y-4">
                <legend class="mb-4 text-lg font-bold text-ink">Autorisations</legend>
                {{ form_row(form.philibertConsent) }}
                {{ form_row(form.imageRightsRefused) }}
            </fieldset>

            <div class="flex flex-wrap gap-3 pt-2">
                <button type="submit" class="btn btn-primary">{{ ui.icon('check') }} Enregistrer la correction</button>
                <a href="{{ path('app_membership_show', {id: application.id}) }}" class="btn btn-secondary">{{ ui.icon('x') }} Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
