{% extends 'app/layout.html.twig' %}
{% import 'app/_icons.html.twig' as ui %}

{% block title %}Pointage - Envie de Jouer{% endblock %}

{% block content %}
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold text-ink">Pointage des consommateurs</h1>
            <p class="mt-1 text-slate-600">
                Un bouton par personne : présente et son euro encaissé. Tout est enregistré au clic,
                il n'y a rien à valider à la fin.
            </p>
        </div>
        <a href="{{ path('app_accounting', {saison: season}) }}" class="btn btn-secondary">{{ ui.icon('download') }} Voir la comptabilité</a>
    </div>

    {# La seance pointee : un evenement du calendrier, celui du jour par defaut. #}
    <form method="get" action="{{ path('app_attendance_log') }}" class="mt-8 flex flex-wrap items-end gap-3" aria-label="Séance pointée">
        <div>
            <label for="p-date" class="mb-1.5 block text-sm font-semibold text-slate-800">Événement</label>
            <select name="date" id="p-date" class="block min-h-11 rounded-lg border border-slate-300 bg-white px-3 py-2 text-base focus:border-brand">
                {% if sessions[day|date('Y-m-d')] is not defined %}
                    <option value="{{ day|date('Y-m-d') }}" selected>{{ event ? event.title : 'Date libre' }} · {{ day|date('d/m/Y') }}</option>
                {% endif %}
                {% for key, session in sessions %}
                    <option value="{{ key }}"{{ key == day|date('Y-m-d') ? ' selected' }}>{{ session.title }} · {{ key|date('d/m/Y') }}</option>
                {% endfor %}
            </select>
        </div>
        <button type="submit" class="btn btn-secondary">{{ ui.icon('eye') }} Afficher</button>
    </form>

    <form method="get" action="{{ path('app_attendance_log') }}" class="mt-4 flex flex-wrap items-end gap-3" aria-label="Date libre">
        <div>
            <label for="p-date-libre" class="mb-1.5 block text-sm font-semibold text-slate-800">Ou une autre date, sans événement</label>
            <input type="date" name="date" id="p-date-libre" {% if not anyDate %}max="{{ today|date('Y-m-d') }}"{% endif %} value="{{ event is null ? day|date('Y-m-d') }}" required class="block min-h-11 rounded-lg border border-slate-300 bg-white px-3 py-2 text-base focus:border-brand">
        </div>
        <button type="submit" class="btn btn-secondary">{{ ui.icon('eye') }} Afficher</button>
    </form>

    <section class="card mt-8" aria-labelledby="titre-pointage">
        <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-slate-100 px-5 py-4">
            <h2 id="titre-pointage" class="text-lg font-bold text-ink">
                {{ event ? event.title : 'Séance' }} <span class="font-medium text-slate-600">· {{ isToday ? 'aujourd\'hui' : (day > today ? 'séance à venir' : 'séance passée') }}, {{ day|format_date(pattern: 'EEEE d MMMM y') }}</span>
            </h2>
            <p class="text-sm text-slate-600">
                <strong>{{ present }}</strong> présent{{ present > 1 ? 's' }},
                <strong>{{ paid }}</strong> réglé{{ paid > 1 ? 's' }} —
                {{ (paid * priceCents / 100)|number_format(2, ',', ' ') }} €
            </p>
        </div>

        {% if not isToday %}
            <p class="border-b border-slate-100 bg-amber-50 px-5 py-3 text-sm text-amber-900" role="note">
                {{ day > today ? 'Séance à venir' : 'Séance passée' }} : les pointages s'enregistrent à la date du {{ day|date('d/m/Y') }}
                et apparaissent à cette date dans la comptabilité.
            </p>
        {% endif %}

        {% if anyDate and others is not empty %}
            <form method="post" action="{{ path('app_attendance_log_add', {date: day|date('Y-m-d')}) }}" class="flex flex-wrap items-end gap-3 border-b border-slate-100 px-5 py-4">
                <input type="hidden" name="_token" value="{{ csrf_token('pointage-ajout-' ~ day|date('Y-m-d')) }}">
                <div class="min-w-0 max-w-full">
                    <label for="p-adherent" class="mb-1.5 block text-sm font-semibold text-slate-800">Pointer un autre adhérent</label>
                    <select name="application" id="p-adherent" required class="block min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-base focus:border-brand">
                        <option value="">Choisir un adhérent</option>
                        {% for other in others %}
                            <option value="{{ other.id }}">{{ other.lastName }} {{ other.firstName }}{{ other.member ? ' · ' ~ other.member.number }}</option>
                        {% endfor %}
                    </select>
                </div>
                <button type="submit" name="action" value="paye" class="btn btn-primary">{{ ui.icon('check') }} Présent · 1 € payé</button>
                <button type="submit" name="action" value="present" class="btn btn-secondary">Venu gratuitement</button>
            </form>
        {% endif %}

        {% if people is empty %}
            <p class="px-5 py-8 text-slate-600">
                Aucun consommateur validé sur la saison {{ season - 1 }}-{{ season }}. La formule se choisit sur le
                bulletin d'adhésion : gratuite à l'année, 1 € par séance.
            </p>
        {% else %}
            <ul class="divide-y divide-slate-100">
                {% for consumer in people %}
                    {% set mark = pointed[consumer.id] ?? null %}
                    {% set token = 'pointage' ~ day|date('Y-m-d') ~ '-' ~ consumer.id %}
                    {% set editable = anyDate or consumer.id in consumerIds %}
                    <li class="flex flex-wrap items-center justify-between gap-3 px-5 py-3">
                        <div class="min-w-0">
                            <p class="font-semibold text-ink">
                                {{ consumer.firstName }} {{ consumer.lastName }}
                                {% if mark and mark.paid %}
                                    <span class="badge bg-emerald-100 text-emerald-800">{{ ui.icon('check', 'size-4') }} 1 € réglé</span>
                                {% elseif mark %}
                                    <span class="badge bg-slate-100 text-slate-700">Venu gratuitement</span>
                                {% endif %}
                            </p>
                            <p class="text-sm text-slate-500">{{ consumer.member ? consumer.member.number : 'Sans numéro' }}</p>
                        </div>

                        {# Trois boutons, trois POST : le geste courant d'abord, et le retrait
                           en dernier pour qu'un pouce ne l'atteigne pas par accident. #}
                        <div class="flex flex-wrap gap-2">
                            {% if editable and not (mark and mark.paid) %}
                                <form method="post" action="{{ path('app_attendance_log_toggle', {date: day|date('Y-m-d'), application: consumer.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token(token) }}">
                                    <input type="hidden" name="action" value="paye">
                                    <button type="submit" class="btn btn-primary">{{ ui.icon('check') }} Présent · 1 € payé</button>
                                </form>
                            {% endif %}
                            {% if editable and mark is null %}
                                <form method="post" action="{{ path('app_attendance_log_toggle', {date: day|date('Y-m-d'), application: consumer.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token(token) }}">
                                    <input type="hidden" name="action" value="present">
                                    <button type="submit" class="btn btn-secondary">Venu gratuitement</button>
                                </form>
                            {% endif %}
                            {% if editable and mark %}
                                <form method="post" action="{{ path('app_attendance_log_toggle', {date: day|date('Y-m-d'), application: consumer.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token(token) }}">
                                    <input type="hidden" name="action" value="retirer">
                                    <button type="submit" class="btn btn-danger">{{ ui.icon('x') }} <span class="sr-only">Retirer le pointage de {{ consumer.firstName }} {{ consumer.lastName }}</span><span aria-hidden="true">Retirer</span></button>
                                </form>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>
{% endblock %}
