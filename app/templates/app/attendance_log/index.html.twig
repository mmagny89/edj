{% extends 'app/layout.html.twig' %}
{% import 'app/_icons.html.twig' as ui %}

{% block title %}Pointage - Envie de Jouer{% endblock %}

{% block content %}
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold text-ink">Pointage des consommateurs</h1>
            <p class="mt-1 text-slate-600">
                Un bouton par personne : présente et son euro encaissé. Tout est enregistré au clic,
                il n'y a rien à valider à la fin.
            </p>
        </div>
        <a href="{{ path('app_accounting', {saison: season}) }}" class="btn btn-secondary">{{ ui.icon('download') }} Voir la comptabilité</a>
    </div>

    {# Le jour pointe : aujourd'hui par defaut, une date passee a la demande. Pas de choix
       d'evenement ni de saison : le jour suffit, la saison s'en deduit. #}
    <form method="get" action="{{ path('app_attendance_log') }}" class="mt-8 flex flex-wrap items-end gap-3" aria-label="Jour pointé">
        <div>
            <label for="p-date" class="mb-1.5 block text-sm font-semibold text-slate-800">Date de la séance</label>
            <input type="date" name="date" id="p-date" value="{{ day|date('Y-m-d') }}" max="{{ today|date('Y-m-d') }}" required
                   class="block min-h-11 rounded-lg border border-slate-300 bg-white px-3 py-2 text-base focus:border-brand">
        </div>
        <button type="submit" class="btn btn-secondary">{{ ui.icon('eye') }} Afficher</button>
        {% if not isToday %}
            <a href="{{ path('app_attendance_log') }}" class="btn btn-secondary">Revenir à aujourd'hui</a>
        {% endif %}
    </form>

    <section class="card mt-8" aria-labelledby="titre-pointage">
        <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-slate-100 px-5 py-4">
            <h2 id="titre-pointage" class="text-lg font-bold text-ink">
                {{ isToday ? 'Aujourd\'hui' : 'Séance passée' }} · {{ day|format_date(pattern: 'EEEE d MMMM y')|capitalize }}
                {% if event %}<span class="font-medium text-slate-600">· {{ event.title }}</span>{% endif %}
            </h2>
            <p class="text-sm text-slate-600">
                <strong>{{ present }}</strong> présent{{ present > 1 ? 's' }},
                <strong>{{ paid }}</strong> réglé{{ paid > 1 ? 's' }} —
                {{ (paid * priceCents / 100)|number_format(2, ',', ' ') }} €
            </p>
        </div>

        {% if not isToday %}
            <p class="border-b border-slate-100 bg-amber-50 px-5 py-3 text-sm text-amber-900" role="note">
                Séance passée : les pointages s'enregistrent à la date du {{ day|date('d/m/Y') }}
                et apparaissent à cette date dans la comptabilité.
            </p>
        {% endif %}

        {% if consumers is empty %}
            <p class="px-5 py-8 text-slate-600">
                Aucun consommateur validé sur la saison {{ season - 1 }}-{{ season }}. La formule se choisit sur le
                bulletin d'adhésion : gratuite à l'année, 1 € par séance.
            </p>
        {% else %}
            <ul class="divide-y divide-slate-100">
                {% for consumer in consumers %}
                    {% set mark = pointed[consumer.id] ?? null %}
                    {% set token = 'pointage' ~ day|date('Y-m-d') ~ '-' ~ consumer.id %}
                    <li class="flex flex-wrap items-center justify-between gap-3 px-5 py-3">
                        <div class="min-w-0">
                            <p class="font-semibold text-ink">
                                {{ consumer.firstName }} {{ consumer.lastName }}
                                {% if mark and mark.paid %}
                                    <span class="badge bg-emerald-100 text-emerald-800">{{ ui.icon('check', 'size-4') }} 1 € réglé</span>
                                {% elseif mark %}
                                    <span class="badge bg-amber-100 text-amber-900">Présent, à régler</span>
                                {% endif %}
                            </p>
                            <p class="text-sm text-slate-500">{{ consumer.member ? consumer.member.number : 'Sans numéro' }}</p>
                        </div>

                        {# Trois boutons, trois POST : le geste courant d'abord, et le retrait
                           en dernier pour qu'un pouce ne l'atteigne pas par accident. #}
                        <div class="flex flex-wrap gap-2">
                            {% if not (mark and mark.paid) %}
                                <form method="post" action="{{ path('app_attendance_log_toggle', {date: day|date('Y-m-d'), application: consumer.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token(token) }}">
                                    <input type="hidden" name="action" value="paye">
                                    <button type="submit" class="btn btn-primary">{{ ui.icon('check') }} Présent · 1 € payé</button>
                                </form>
                            {% endif %}
                            {% if mark is null %}
                                <form method="post" action="{{ path('app_attendance_log_toggle', {date: day|date('Y-m-d'), application: consumer.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token(token) }}">
                                    <input type="hidden" name="action" value="present">
                                    <button type="submit" class="btn btn-secondary">Présent, sans payer</button>
                                </form>
                            {% endif %}
                            {% if mark %}
                                <form method="post" action="{{ path('app_attendance_log_toggle', {date: day|date('Y-m-d'), application: consumer.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token(token) }}">
                                    <input type="hidden" name="action" value="retirer">
                                    <button type="submit" class="btn btn-danger">{{ ui.icon('x') }} <span class="sr-only">Retirer le pointage de {{ consumer.firstName }} {{ consumer.lastName }}</span><span aria-hidden="true">Retirer</span></button>
                                </form>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>
{% endblock %}
