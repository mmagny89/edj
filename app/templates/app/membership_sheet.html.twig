{% extends 'app/shell.html.twig' %}

{% import 'app/_icons.html.twig' as ui %}

{% block title %}Fiche d'adhésion - {{ application.firstName }} {{ application.lastName }}{% endblock %}

{# Fiche autonome, sans barre laterale : elle se lit a l'ecran comme sur papier.
   Le fond de page est blanc a l'impression, et la barre d'actions disparait. #}
{% block body %}
    <div class="mx-auto max-w-3xl px-4 py-6 print:max-w-none print:p-0">
        <div class="mb-6 flex flex-wrap items-center justify-between gap-3 print:hidden" data-controller="print">
            <a href="{{ path('app_membership_show', {id: application.id}) }}" class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand underline underline-offset-4 hover:text-brand-dark">
                {{ ui.icon('arrow-left', 'size-4') }} Retour au bulletin
            </a>
            <button type="button" class="btn btn-primary" data-action="print#now">{{ ui.icon('printer') }} Imprimer</button>
        </div>

        <article class="rounded-xl border border-slate-200 bg-white p-8 text-slate-900 shadow-sm print:rounded-none print:border-0 print:p-0 print:shadow-none">
            <header class="flex items-center justify-between gap-4 border-b-2 border-ink pb-4">
                <div>
                    <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">Association Envie de Jouer · Joigny</p>
                    <h1 class="mt-1 text-2xl font-bold text-ink">Fiche d'adhésion</h1>
                </div>
                <img src="/img/edj-mascotte-transparent.png" alt="" class="size-16" width="64" height="64">
            </header>

            <p class="mt-3 text-sm text-slate-600">
                Bulletin n° {{ application.id }} ·
                {% if application.paper %}saisi d'après la fiche papier remise le {{ application.submittedAt|date('d/m/Y') }}
                {% else %}déposé en ligne le {{ application.submittedAt|date('d/m/Y à H:i') }}{% endif %}
            </p>

            <section class="mt-6 break-inside-avoid">
                <h2 class="border-b border-slate-300 pb-1 text-base font-bold uppercase tracking-wide">Adhérent</h2>
                <dl class="mt-3 grid grid-cols-[10rem_1fr] gap-x-4 gap-y-2 text-sm">
                    <dt class="font-semibold text-slate-600">Nom</dt><dd>{{ application.lastName }}</dd>
                    <dt class="font-semibold text-slate-600">Prénom</dt><dd>{{ application.firstName }}</dd>
                    <dt class="font-semibold text-slate-600">Date de naissance</dt>
                    <dd>{{ application.birthDate|date('d/m/Y') }}{% if application.isMinor %} (mineur){% endif %}</dd>
                    <dt class="font-semibold text-slate-600">Adresse</dt>
                    <dd>{% if application.address %}{{ application.address }}, {% endif %}{{ application.postalCode }} {{ application.city }}</dd>
                    <dt class="font-semibold text-slate-600">Téléphone</dt><dd>{{ application.phone ?: '—' }}</dd>
                    <dt class="font-semibold text-slate-600">E-mail</dt><dd>{{ application.email }}</dd>
                </dl>
            </section>

            <section class="mt-6 break-inside-avoid">
                <h2 class="border-b border-slate-300 pb-1 text-base font-bold uppercase tracking-wide">Adhésion</h2>
                <dl class="mt-3 grid grid-cols-[10rem_1fr] gap-x-4 gap-y-2 text-sm">
                    <dt class="font-semibold text-slate-600">Formule</dt><dd>{{ application.membershipType.label }}</dd>
                    <dt class="font-semibold text-slate-600">Tarif</dt><dd>{{ application.membershipType.priceLabel }}</dd>
                    {% if application.principalMemberName %}
                        <dt class="font-semibold text-slate-600">Adhérent principal</dt><dd>{{ application.principalMemberName }}</dd>
                    {% endif %}
                </dl>
            </section>

            {% if application.isMinor %}
                <section class="mt-6 break-inside-avoid">
                    <h2 class="border-b border-slate-300 pb-1 text-base font-bold uppercase tracking-wide">Responsable légal</h2>
                    <dl class="mt-3 grid grid-cols-[10rem_1fr] gap-x-4 gap-y-2 text-sm">
                        <dt class="font-semibold text-slate-600">Nom</dt><dd>{{ application.guardianLastName }}</dd>
                        <dt class="font-semibold text-slate-600">Prénom</dt><dd>{{ application.guardianFirstName }}</dd>
                        <dt class="font-semibold text-slate-600">E-mail</dt><dd>{{ application.guardianEmail }}</dd>
                    </dl>
                </section>
            {% endif %}

            <section class="mt-6 break-inside-avoid">
                <h2 class="border-b border-slate-300 pb-1 text-base font-bold uppercase tracking-wide">Déclarations</h2>
                <ul class="mt-3 space-y-1.5 text-sm">
                    <li><strong>Droit à l'image :</strong> {{ application.imageRightsRefused ? 'REFUSÉ — ne pas utiliser de photo' : 'accepté' }}</li>
                    <li><strong>Communication de l'e-mail à Philibert :</strong> {{ application.philibertConsent ? 'autorisée' : 'refusée' }}</li>
                    <li><strong>Statuts :</strong> lus et acceptés</li>
                    <li><strong>Règlement intérieur :</strong> lu et accepté</li>
                </ul>
            </section>

            <section class="mt-8 grid grid-cols-2 gap-8 break-inside-avoid text-sm">
                <div>
                    {% if application.paper %}
                        <p>Fiche papier signée, remise le {{ application.submittedAt|date('d/m/Y') }}.</p>
                        <p class="mt-1 text-slate-600">Le papier original fait foi : le conserver.</p>
                    {% else %}
                        <p>Fait à {{ application.signaturePlace }}, le {{ application.submittedAt|date('d/m/Y') }}</p>
                        <p class="mt-1">Signé électroniquement : <strong>{{ application.signatureName }}</strong></p>
                    {% endif %}
                </div>
                <div>
                    <p class="font-semibold">Cotisation réglée</p>
                    <p class="mt-1 text-slate-600">☐ espèces &nbsp; ☐ chèque &nbsp; ☐ gratuite</p>
                    <p class="mt-6 border-t border-slate-400 pt-1 text-xs text-slate-500">Visa de l'association</p>
                </div>
            </section>
        </article>
    </div>
{% endblock %}
