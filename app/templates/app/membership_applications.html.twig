{% extends 'app/layout.html.twig' %}

{% block title %}Adhésions - Envie de Jouer{% endblock %}

{% block content %}
    <h1 class="text-3xl font-bold text-ink">Adhésions</h1>
    <p class="mt-1 text-slate-500">Bulletins déposés depuis le site, du plus récent au plus ancien.</p>

    <section class="card mt-8" aria-labelledby="titre-bulletins">
        <h2 id="titre-bulletins" class="border-b border-slate-100 px-5 py-4 text-lg font-bold text-ink">
            Bulletins <span class="font-medium text-slate-400">{{ applications|length }}</span>
        </h2>

        {% if applications is empty %}
            <p class="px-5 py-8 text-slate-500">Aucun bulletin déposé pour le moment.</p>
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
                        <tr>
                            <th scope="col" class="px-5 py-3 font-semibold">Déposé le</th>
                            <th scope="col" class="px-3 py-3 font-semibold">Adhérent</th>
                            <th scope="col" class="px-3 py-3 font-semibold">Contact</th>
                            <th scope="col" class="px-3 py-3 font-semibold">Formule</th>
                            <th scope="col" class="px-3 py-3 font-semibold">Rattachement</th>
                            <th scope="col" class="px-5 py-3 font-semibold">Autorisations</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for application in applications %}
                            <tr>
                                <td class="whitespace-nowrap px-5 py-3 align-top">
                                    <div class="font-semibold text-slate-800">{{ application.submittedAt|date('d/m/Y') }}</div>
                                    <div class="text-xs text-slate-500">{{ application.submittedAt|date('H:i') }}</div>
                                </td>

                                <td class="px-3 py-3 align-top">
                                    <div class="font-semibold text-slate-800">{{ application.firstName }} {{ application.lastName }}</div>
                                    <div class="text-xs text-slate-500">
                                        Né(e) le {{ application.birthDate|date('d/m/Y') }}
                                        {% if application.isMinor %}<span class="badge ml-1 bg-amber-100 text-amber-900">mineur</span>{% endif %}
                                    </div>
                                </td>

                                <td class="px-3 py-3 align-top">
                                    <a class="font-semibold text-brand underline underline-offset-2 hover:text-brand-dark" href="mailto:{{ application.email }}">{{ application.email }}</a>
                                    {% if application.phone %}<div class="text-xs text-slate-500">{{ application.phone }}</div>{% endif %}
                                    <div class="text-xs text-slate-500">
                                        {% if application.address %}{{ application.address }}, {% endif %}{{ application.postalCode }} {{ application.city }}
                                    </div>
                                </td>

                                <td class="px-3 py-3 align-top">
                                    <div class="text-slate-800">{{ application.membershipType.label }}</div>
                                    <div class="text-xs text-slate-500">{{ application.membershipType.priceLabel }}</div>
                                </td>

                                <td class="px-3 py-3 align-top text-xs text-slate-500">
                                    {% if application.principalMemberName %}
                                        <div>Adhérent principal :<br><span class="text-slate-700">{{ application.principalMemberName }}</span></div>
                                    {% endif %}
                                    {% if application.isMinor %}
                                        <div class="mt-1">
                                            Responsable légal :<br>
                                            <span class="text-slate-700">{{ application.guardianFirstName }} {{ application.guardianLastName }}</span><br>
                                            <a class="font-semibold text-brand underline underline-offset-2" href="mailto:{{ application.guardianEmail }}">{{ application.guardianEmail }}</a>
                                        </div>
                                    {% endif %}
                                    {% if not application.principalMemberName and not application.isMinor %}—{% endif %}
                                </td>

                                {# Les deux reponses qui engagent l'association : un refus de droit
                                   a l'image doit se voir sans avoir a lire la ligne. #}
                                <td class="px-5 py-3 align-top">
                                    <div class="flex flex-col items-start gap-1">
                                        {% if application.imageRightsRefused %}
                                            <span class="badge bg-red-100 text-red-900">Photos refusées</span>
                                        {% else %}
                                            <span class="badge bg-green-100 text-green-900">Photos acceptées</span>
                                        {% endif %}
                                        {% if application.philibertConsent %}
                                            <span class="badge bg-blue-100 text-blue-900">Philibert</span>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}
