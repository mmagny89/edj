{% extends 'app/layout.html.twig' %}

{% import 'app/_icons.html.twig' as ui %}

{% block title %}Bulletin d'adhésion - Envie de Jouer{% endblock %}

{% macro row(label, value) %}
    <div class="grid gap-1 py-3 sm:grid-cols-3 sm:gap-4">
        <dt class="text-sm font-semibold text-slate-600">{{ label }}</dt>
        <dd class="text-slate-900 sm:col-span-2">{{ value ?: '—' }}</dd>
    </div>
{% endmacro %}

{% block content %}
    {% import _self as f %}

    <a href="{{ path('app_membership_applications') }}" class="inline-flex min-h-11 items-center gap-1.5 py-2 text-sm font-semibold text-brand underline underline-offset-4 hover:text-brand-dark">
        {{ ui.icon('arrow-left', 'size-4') }} Retour aux adhésions
    </a>

    <div class="mt-3 flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold text-ink">
                {% if application.anonymized %}Bulletin anonymisé{% else %}{{ application.firstName }} {{ application.lastName }}{% endif %}
            </h1>
            {% if application.memberNumber %}
                <p class="mt-1 font-mono text-lg font-bold tracking-wider text-brand">{{ application.memberNumber }}</p>
            {% endif %}
            <p class="mt-1 text-slate-600">
                <span class="badge mr-1 border {{ application.status.badgeClass }}">{{ application.status.label }}</span>
                {% if application.paymentMethod %}<span class="badge mr-1 bg-slate-100 text-slate-700">{{ application.paymentMethod.label }}</span>{% endif %}
                {% if application.paper %}
                    <span class="badge mr-1 bg-amber-100 text-amber-900">Fiche papier</span> Remise le {{ application.submittedAt|date('d/m/Y') }}
                {% else %}
                    Déposé le {{ application.submittedAt|date('d/m/Y à H:i') }}
                {% endif %}
                {% if application.isMinor and not application.anonymized %}<span class="badge ml-1 bg-amber-100 text-amber-900">mineur</span>{% endif %}
            </p>
        </div>

        {% if not application.anonymized %}
            <div class="flex flex-wrap gap-3">
                <a href="{{ path('app_membership_sheet', {id: application.id}) }}" target="_blank" rel="noopener" class="btn btn-secondary">
                    {{ ui.icon('printer') }} Imprimer la fiche<span class="sr-only"> (nouvel onglet)</span>
                </a>
                <a href="{{ path('app_membership_card', {id: application.id}) }}" target="_blank" rel="noopener" class="btn btn-secondary">
                    {{ ui.icon('eye') }} Voir la carte<span class="sr-only"> d'adhérent, au format PDF (nouvel onglet)</span>
                </a>
                <form method="post" action="{{ path('app_membership_anonymize', {id: application.id}) }}"
                      data-controller="confirm"
                      data-confirm-message-value="Anonymiser ce bulletin ? Le nom, les coordonnées et la signature seront effacés définitivement."
                      data-action="submit->confirm#ask">
                    <input type="hidden" name="_token" value="{{ csrf_token('anonymize_membership_' ~ application.id) }}">
                    <button type="submit" class="btn btn-danger">{{ ui.icon('eye-slash') }} Anonymiser</button>
                </form>
            </div>
        {% endif %}
    </div>

    {% if application.anonymized %}
        <div class="mt-6 rounded-lg border border-slate-300 bg-slate-100 px-4 py-3 text-sm text-slate-700" role="status">
            Ce bulletin a été anonymisé le {{ application.anonymizedAt|date('d/m/Y') }}. Il ne désigne plus personne :
            seuls la formule, les autorisations, la date de dépôt et l'année de naissance sont conservées.
        </div>
    {% endif %}

    <section class="card mt-8 p-6" aria-labelledby="t-etat">
        <h2 id="t-etat" class="text-lg font-bold text-ink">État de l'adhésion</h2>
        <p class="mt-2 text-sm text-slate-600">
            {% if application.validated %}
                Validée le {{ application.statusChangedAt|date('d/m/Y') }}{% if application.paymentMethod %}, réglée par {{ application.paymentMethod.label|lower }}{% else %} (formule gratuite à l'année){% endif %}.
            {% elseif application.cancelled %}
                Annulée le {{ application.statusChangedAt|date('d/m/Y') }}. Le bulletin reste consultable.
            {% else %}
                En attente :
                {% if application.membershipType.amountDue %}
                    <strong>{{ application.membershipType.amountDueLabel }}</strong> restent à encaisser.
                {% else %}
                    la formule consommateur est gratuite à l'année, il n'y a rien à encaisser.
                {% endif %}
            {% endif %}
        </p>

        <div class="mt-5 flex flex-wrap items-end gap-3">
            {% if not application.validated %}
                <form method="post" action="{{ path('app_membership_validate', {id: application.id}) }}" class="flex flex-wrap items-end gap-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('membership_status_' ~ application.id) }}">
                    {% if application.membershipType.value != 'consommateur' %}
                        <div>
                            <label for="moyen-reglement" class="mb-1.5 block text-sm font-semibold text-slate-800">Réglée par</label>
                            <select name="paymentMethod" id="moyen-reglement" required
                                    class="block min-h-11 rounded-lg border border-slate-300 px-3 py-2 text-base focus:border-brand">
                                {% for method in enum_cases('App\\Enum\\PaymentMethod') %}
                                    <option value="{{ method.value }}" {{ application.paymentMethod == method ? 'selected' }}>{{ method.label }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    {% endif %}
                    <button type="submit" class="btn btn-primary">{{ ui.icon('check') }} Valider l'adhésion</button>
                </form>
            {% endif %}

            {% if not application.cancelled %}
                <form method="post" action="{{ path('app_membership_cancel', {id: application.id}) }}"
                      data-controller="confirm"
                      data-confirm-message-value="Annuler cette adhésion ? Le bulletin reste consultable, mais l'adhésion ne compte plus."
                      data-action="submit->confirm#ask">
                    <input type="hidden" name="_token" value="{{ csrf_token('membership_status_' ~ application.id) }}">
                    <button type="submit" class="btn btn-danger">{{ ui.icon('x') }} Annuler l'adhésion</button>
                </form>
            {% endif %}

            {% if not application.pending %}
                <form method="post" action="{{ path('app_membership_reopen', {id: application.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('membership_status_' ~ application.id) }}">
                    <button type="submit" class="btn btn-secondary">{{ ui.icon('arrow-left') }} Remettre en attente</button>
                </form>
            {% endif %}
        </div>
    </section>

    <div class="mt-8 grid gap-6 lg:grid-cols-2">
        {% if not application.anonymized %}
            <section class="card p-6" aria-labelledby="t-adherent">
                <h2 id="t-adherent" class="text-lg font-bold text-ink">Adhérent</h2>
                <dl class="mt-2 divide-y divide-slate-100">
                    {{ f.row('Nom', application.lastName) }}
                    {{ f.row('Prénom', application.firstName) }}
                    {{ f.row('Date de naissance', application.birthDate|date('d/m/Y')) }}
                    {{ f.row('Adresse', application.address) }}
                    {{ f.row('Code postal et ville', application.postalCode ~ ' ' ~ application.city) }}
                    {{ f.row('Téléphone', application.phone) }}
                    <div class="grid gap-1 py-3 sm:grid-cols-3 sm:gap-4">
                        <dt class="text-sm font-semibold text-slate-600">E-mail</dt>
                        <dd class="sm:col-span-2"><a class="font-semibold text-brand underline underline-offset-2 hover:text-brand-dark" href="mailto:{{ application.email }}">{{ application.email }}</a></dd>
                    </div>
                </dl>
            </section>
        {% endif %}

        <section class="card p-6" aria-labelledby="t-adhesion">
            <h2 id="t-adhesion" class="text-lg font-bold text-ink">Adhésion</h2>
            <dl class="mt-2 divide-y divide-slate-100">
                {{ f.row('Formule', application.membershipType.label) }}
                {{ f.row('Montant dû', application.membershipType.amountDueLabel) }}
                {% if not application.anonymized and application.principalMemberName %}
                    <div class="grid gap-1 py-3 sm:grid-cols-3 sm:gap-4">
                        <dt class="text-sm font-semibold text-slate-600">Adhérent principal</dt>
                        <dd class="text-slate-900 sm:col-span-2">
                            {{ application.principalMemberName }}
                            {# Le bulletin public laisse saisir ce nom en texte libre : la
                               fiche dit s'il correspond a une adhesion individuelle connue,
                               plutot que de le presenter comme acquis. #}
                            {% if principal %}
                                <a href="{{ path('app_membership_show', {id: principal.id}) }}"
                                   class="badge ml-1 border border-emerald-300 bg-emerald-50 text-emerald-900 underline underline-offset-2">
                                    {{ principal.memberNumber }}
                                </a>
                            {% else %}
                                <span class="badge ml-1 border border-amber-300 bg-amber-50 text-amber-900">aucune adhésion individuelle à ce nom</span>
                            {% endif %}
                        </dd>
                    </div>
                {% endif %}
            </dl>

            {% if application.isMinor and not application.anonymized %}
                <h3 class="mt-5 text-base font-bold text-ink">Responsable légal</h3>
                <dl class="mt-2 divide-y divide-slate-100">
                    {{ f.row('Nom', application.guardianLastName) }}
                    {{ f.row('Prénom', application.guardianFirstName) }}
                    <div class="grid gap-1 py-3 sm:grid-cols-3 sm:gap-4">
                        <dt class="text-sm font-semibold text-slate-600">E-mail</dt>
                        <dd class="sm:col-span-2"><a class="font-semibold text-brand underline underline-offset-2 hover:text-brand-dark" href="mailto:{{ application.guardianEmail }}">{{ application.guardianEmail }}</a></dd>
                    </div>
                </dl>
            {% endif %}
        </section>

        <section class="card p-6 lg:col-span-2" aria-labelledby="t-declarations">
            <h2 id="t-declarations" class="text-lg font-bold text-ink">Déclarations</h2>
            <ul class="mt-4 grid gap-3 sm:grid-cols-2">
                <li class="flex items-center gap-3">
                    {% if application.imageRightsRefused %}
                        <span class="badge bg-red-100 text-red-900">Photos refusées</span>
                    {% else %}
                        <span class="badge bg-green-100 text-green-900">Photos acceptées</span>
                    {% endif %}
                    <span class="text-sm">Droit à l'image</span>
                </li>
                <li class="flex items-center gap-3">
                    {% if application.philibertConsent %}
                        <span class="badge bg-blue-100 text-blue-900">Autorisée</span>
                    {% else %}
                        <span class="badge bg-slate-200 text-slate-700">Refusée</span>
                    {% endif %}
                    <span class="text-sm">Communication de l'e-mail à Philibert</span>
                </li>
                <li class="flex items-center gap-3"><span class="badge bg-green-100 text-green-900">Acceptés</span><span class="text-sm">Statuts</span></li>
                <li class="flex items-center gap-3"><span class="badge bg-green-100 text-green-900">Accepté</span><span class="text-sm">Règlement intérieur</span></li>
            </ul>

            {% if not application.anonymized %}
                <p class="mt-5 border-t border-slate-100 pt-4 text-sm text-slate-600">
                    {% if application.paper %}
                        Fiche papier signée, remise le {{ application.submittedAt|date('d/m/Y') }} : le papier original fait foi.
                    {% else %}
                        Fait à {{ application.signaturePlace }}, le {{ application.submittedAt|date('d/m/Y') }}.
                        Signé : <strong class="text-slate-900">{{ application.signatureName }}</strong>
                    {% endif %}
                </p>
            {% endif %}
        </section>
    </div>
{% endblock %}
