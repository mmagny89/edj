{% extends 'emails/base.html.twig' %}

{% block title %}{{ upgraded ? "Passage à l'adhésion annuelle" : "Modification d'adhésion" }}{% endblock %}
{% block preheader %}{{ application.firstName }} {{ application.lastName }} ({{ application.memberNumber }}){% endblock %}

{% block content %}
    <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;color:#171922;">{{ upgraded ? "Passage à l'adhésion annuelle" : "Modification d'adhésion" }}</h1>
    <p style="margin:0 0 16px;">
        <strong>{{ application.firstName }} {{ application.lastName }}</strong>
        ({{ application.memberNumber }}) a modifié son adhésion depuis le site.
    </p>

    {% if upgraded %}
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 20px;background:#fdf3c4;border:1px solid #e9c33a;border-radius:8px;">
            <tr>
                <td style="padding:14px 16px;font-size:15px;">
                    <strong>{{ application.membershipType.label }}</strong><br>
                    {% if application.amountDue %}
                    Cotisation à encaisser : <strong>{{ application.amountDueLabel }}</strong>.<br>
                    <span style="font-size:13px;color:#475569;">L'adhésion est repassée « en attente » tant qu'elle n'est pas encaissée.</span>
                    {% else %}
                    Rien à encaisser : <strong>{{ application.amountDueLabel }}</strong>.
                    {% endif %}
                </td>
            </tr>
        </table>
    {% endif %}

    <h2 style="margin:0 0 8px;font-size:16px;color:#171922;">Fiche actuelle</h2>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:14px;border-top:1px solid #e5dcc0;">
        {% set rows = [
            ['Nom', application.lastName ~ ' ' ~ application.firstName],
            ['Naissance', application.birthDate ? application.birthDate|date('d/m/Y') : null],
            ['Adresse', application.address],
            ['Code postal et ville', application.postalCode ~ ' ' ~ application.city],
            ['Téléphone', application.phone],
            ['E-mail', application.email],
            ['Formule', application.membershipType.label],
            ['Adhérent principal', application.principalMemberName],
        ] %}
        {% for row in rows %}
            {% if row[1] %}
                <tr>
                    <td style="padding:7px 12px 7px 0;width:38%;color:#475569;border-bottom:1px solid #e5dcc0;vertical-align:top;">{{ row[0] }}</td>
                    <td style="padding:7px 0;border-bottom:1px solid #e5dcc0;vertical-align:top;">{{ row[1] }}</td>
                </tr>
            {% endif %}
        {% endfor %}
        {% if application.isMinor %}
            <tr>
                <td style="padding:7px 12px 7px 0;color:#475569;border-bottom:1px solid #e5dcc0;vertical-align:top;">Responsable légal</td>
                <td style="padding:7px 0;border-bottom:1px solid #e5dcc0;vertical-align:top;">{{ application.guardianFirstName }} {{ application.guardianLastName }}{% if application.guardianEmail %}<br>{{ application.guardianEmail }}{% endif %}</td>
            </tr>
        {% endif %}
        <tr>
            <td style="padding:7px 12px 7px 0;color:#475569;vertical-align:top;">Autorisations</td>
            <td style="padding:7px 0;vertical-align:top;">
                Philibert : {{ application.philibertConsent ? 'autorisé' : 'refusé' }}<br>
                Droit à l'image : {{ application.imageRightsRefused ? 'refusé' : 'accepté' }}
            </td>
        </tr>
    </table>
{% endblock %}

{% block footer %}
    Répondre à ce message écrit à l'adhérent.<br>
{% endblock %}
