<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
</head>
{# Aux couleurs du site : fond bleu clair, bandeau et filet jaune, bleu d'association
   pour les liens. Tout est en ligne et en tableaux : les clients de messagerie
   ignorent les feuilles de style et les mises en page modernes. #}
<body style="margin:0;padding:24px 12px;background:#a8b7df;font-family:Arial,Helvetica,sans-serif;color:#171922;line-height:1.55;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;margin:0 auto;background:#fffaf0;border-radius:14px;border:2px solid #171922;">
    <tr>
        <td style="padding:18px 28px;background:#e9c33a;border-radius:12px 12px 0 0;border-bottom:2px solid #171922;">
            <table role="presentation" cellpadding="0" cellspacing="0">
                <tr>
                    {% if logo_cid is defined and logo_cid %}
                        <td style="padding-right:14px;vertical-align:middle;">
                            <img src="cid:{{ logo_cid }}" alt="" width="56" height="56" style="display:block;width:56px;height:56px;border-radius:12px;border:2px solid #171922;">
                        </td>
                    {% endif %}
                    <td style="vertical-align:middle;">
                        <span style="display:block;font-size:22px;font-weight:bold;color:#171922;line-height:1.2;">Envie de Jouer</span>
                        <span style="display:block;font-size:13px;color:#171922;">Association de jeux de société · Joigny</span>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <tr>
        <td style="padding:28px;font-size:16px;color:#171922;">
            {# body_html vient de MailingTemplate::normalize : HTML nettoye, variables echappees. #}
            {{ body_html|raw }}
        </td>
    </tr>
    <tr>
        <td style="padding:16px 28px 22px;font-size:12px;color:#475569;border-top:2px solid #171922;background:#f3ecd8;border-radius:0 0 12px 12px;">
            Vous recevez ce message parce que vous êtes adhérent(e) d'Envie de Jouer (n° {{ number }}).
            {% if unsubscribe_url %}
                <a href="{{ unsubscribe_url }}" style="color:#255db0;">Ne plus recevoir les messages de l'association</a>.
            {% else %}
                [Ici : le lien de désinscription propre à chaque adhérent.]
            {% endif %}
            <br>Envie de Jouer — Joigny
        </td>
    </tr>
</table>
</body>
</html>
