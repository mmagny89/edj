<!DOCTYPE html>
<html lang="fr">
<body style="margin:0;padding:24px;background:#f1f5f9;font-family:Arial,Helvetica,sans-serif;color:#1e293b;line-height:1.55;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:12px;border:1px solid #e2e8f0;">
    <tr>
        <td style="padding:28px;font-size:15px;">
            {# body_html est echappe par MailingTemplate::toHtml : seul le texte saisi, jamais du HTML. #}
            {{ body_html|raw }}
        </td>
    </tr>
    <tr>
        <td style="padding:12px 28px 28px;font-size:12px;color:#475569;border-top:1px solid #e2e8f0;">
            Vous recevez ce message parce que vous êtes adhérent(e) d'Envie de Jouer (n° {{ number }}).
            {% if unsubscribe_url %}
                <a href="{{ unsubscribe_url }}" style="color:#475569;">Ne plus recevoir les messages de l'association</a>.
            {% else %}
                [Ici : le lien de désinscription propre à chaque adhérent.]
            {% endif %}
            <br>Envie de Jouer — Joigny
        </td>
    </tr>
</table>
</body>
</html>
