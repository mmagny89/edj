{% extends 'emails/base.html.twig' %}

{% block title %}Votre fiche d'adhérent{% endblock %}
{% block preheader %}Le lien vers votre fiche et votre carte, valable {{ lifetime }}.{% endblock %}

{% block content %}
    <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;color:#171922;">Votre fiche d'adhérent</h1>
    <p style="margin:0 0 12px;">Bonjour {{ application.firstName }},</p>
    <p style="margin:0 0 12px;">
        Quelqu'un vient de demander l'accès à la fiche d'adhérent
        <strong>{{ application.memberNumber }}</strong>. Si c'est bien vous, ouvrez ce lien :
    </p>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0;">
                <tr>
                    <td align="center" bgcolor="#255db0" style="background-color:#255db0;border-radius:8px;">
                        <a href="{{ url }}" style="display:inline-block;padding:13px 22px;font-size:16px;font-weight:bold;color:#ffffff;text-decoration:none;border-radius:8px;">Voir ma fiche et ma carte</a>
                    </td>
                </tr>
            </table>
    <p style="margin:0;font-size:13px;color:#475569;">
        Ce lien n'est valable que {{ lifetime }} :
        passé ce délai, redemandez-en un depuis le site. Si vous n'avez rien demandé, ignorez ce message :
        personne n'a eu accès à votre fiche.
    </p>
{% endblock %}
